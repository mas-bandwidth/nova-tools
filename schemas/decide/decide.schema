// decide.schema: the decide area's records. The Go is generated into
// pkg/decidewire (go generate ./pkg/decidewire).
//
// Two classes (S1). A FIXED table is a struct: small, bounded, a stable layout
// whose reader is always the same version or newer. A VARIABLE table is a
// document held by pointer, sized by its content and open-ended, with a JSON
// text form. Every table reads the same way through pkg/schemaread, in three
// forms: binary wire, padded standard base64 of it, and the JSON text.
//
// A bound is declared only where the Go code enforces one. The PR body lists,
// for every field, the schema bound and the code's (file:line, or none). A text
// the code does not bound is an unbounded string (*string), a list it does not
// bound is an unbounded list ([]T); a table holding either is variable. Only
// Usage (no bound at all) and RawTokens (every count non-negative, raw.go)
// stay fixed.
//
// A unit that declares a variable table gets no separate fixed-form wire for
// its fixed tables at this pin (the compiler emits form 3 only when every table
// in the unit is fixed), so the fixed tables keep their class and ride form 1.
//
// Field names avoid the table's own name (C# forbids it): decision_name is the
// struct's Decision field of Decision, step the Act field of Act.
package decidewire

// ---- the decision (pkg/decide/decide.go) ----

// Question types: Choice and Noul (SPEC-NOVA-DECIDE section 2).
enum AnswerType { Choice, Noul }

// Usage: pkg/decide Usage, what one ask spent; zero is unreported. The code
// bounds neither count (decide.go Usage), so none is declared.
fixed table Usage
{
    input_tokens  int64
    output_tokens int64
}

// OptionP: one entry of an Answer's P map, an option and its probability. The
// probability must lie in [0, 1] and not be NaN (decide.go Check, record.go
// recordedProbabilities); a float64 has no declared range in v1, so the reader
// holds it.
table OptionP
{
    option *string
    p      float64
}

// Answer: pkg/decide Answer. P is an open-ended list: a choice names any number
// of options, at least two (decide.go ParseSchema), and Check sets no ceiling.
// Confidence and Method are the choice answered with no probabilities
// (SPEC-NOVA-DECIDE section 3); Check holds neither to [0, 1].
table Answer
{
    kind       AnswerType
    value      *string
    p          []OptionP
    confidence float64
    method     *string
}

// NamedAnswer: one entry of a Decision's Answers map, the question's name and
// its answer.
table NamedAnswer
{
    question *string
    answer   Answer
}

// Input: one entry of a Decision's Inputs map, an input's name and its text.
table Input
{
    key   *string
    value *string
}

// Decided: pkg/decide Decided, the decision as it rides on a card, one line
// `<option> p=<p> op=<op>`. ParseDecided refuses p outside [0, 1] and any
// field holding whitespace (attempt.go ParseDecided).
table Decided
{
    value *string
    p     float64
    op    *string
}

// ---- the record lines (pkg/decide/record.go) ----

// Decision: pkg/decide Decision as the record writes it on a decision line. The
// folded-in Outcome and Acts are never written on this line, so they are not
// fields here. The attempt decision (attempt.go ParseAttempt) is this table
// with decision_name "attempt". state is the exact text asked over, held at
// its own size; inputs and answers are open-ended lists.
table Decision
{
    id            *string
    decision_name *string
    schema        *string
    backend       *string
    at            *string
    inputs        []Input
    state         *string
    answers       []NamedAnswer
    usage         Usage
}

// Outcome: pkg/decide Outcome, what turned out to be true about a decision. It
// is attached once (record.go Attach).
table Outcome
{
    id    *string
    label *string
    note  *string
    at    *string
}

// Act: pkg/decide Act, one step of applying a decision: step is applying,
// applied or refused; op is the operation id the verbs carry.
table Act
{
    id   *string
    step *string
    op   *string
    at   *string
}

enum LineKind { Decision, Outcome, Act }

// RecordLine: the record's line (record.go line). A line is one record
// (record.go parse refuses a line holding more than one): kind names the one
// that is present, and the reader refuses a line whose other two are set.
table RecordLine
{
    kind        LineKind
    as_decision *Decision
    as_outcome  *Outcome
    as_act      *Act
}

// ---- the import (pkg/decide/import.go) ----

// JudgmentId: one judgment id an export line answers.
table JudgmentId
{
    id *string
}

// ImportLogLine: the part of a nova-sprint log --json export line the import
// reads (import.go judgmentItems): the verb and every judgment id it answers
// (the code takes every id of the line).
table ImportLogLine
{
    verb    *string
    answers []JudgmentId
}

// ---- the raw card cost (pkg/cardcost/raw.go) ----

enum Billing { Metered, Plan, Subscription }

// RawTokens: RawRecord.Tokens, the original counters; absence and zero differ
// (raw.go), so each is optional. The keys are museRawKeys; a count is a
// non-negative int64 (raw.go:55, validateRawJSON).
fixed table RawTokens
{
    input_tokens       ?int64 | min = 0, max = 9223372036854775807
    output_tokens      ?int64 | min = 0, max = 9223372036854775807
    cached_tokens      ?int64 | min = 0, max = 9223372036854775807
    cache_write_tokens ?int64 | min = 0, max = 9223372036854775807
    cache_read_tokens  ?int64 | min = 0, max = 9223372036854775807
    reasoning_tokens   ?int64 | min = 0, max = 9223372036854775807
}

// RawRecord: cardcost RawRecord. Validate (raw.go:51) holds harness to muse,
// execution to fleet, source_schema to muse-jsonl-v1, producer_version
// non-empty and billing one of the three; the reader refuses any other.
table RawRecord
{
    harness          *string
    execution        *string
    source_schema    *string
    producer_version *string
    billing          Billing
    tokens           RawTokens
}

// RawUsage: cardcost RawUsage. Validate (raw.go:47) holds version to 1 and at
// least one record; MaxRawBytes (raw.go:21, 32768) bounds the JSON envelope,
// and the smallest valid record is 120 bytes of JSON, so a valid envelope holds
// at most 270 records.
table RawUsage
{
    version uint32           | min = 0, max = 4294967295
    records [..270]RawRecord
}

// ---- the card contract file (pkg/cardcontract/contract.go) ----

enum FrameKind { Work, Read }

// StagePath: one recipe file a frame's Stage names, relative to Recipes.
table StagePath
{
    path *string
}

// Frame: cardcontract Frame, the frame the member hands native as a file.
// ReadFrame (contract.go:142) refuses a kind that is not work or read and an
// empty card. The code bounds no length, count or number.
table Frame
{
    kind                    FrameKind
    card                    *string
    attempt                 int64
    tier                    *string
    model                   *string
    repo                    *string
    base_ref                *string
    stage_sha               *string
    branch                  *string
    prev_head               *string
    prev_attempt            int64
    why                     *string
    finding                 *string
    fix                     *string
    review_base             *string
    stage                   []StagePath
    recipes                 *string
    decide_bounce           *string
    decide_review           *string
    decide_gate_flaky       *string
    decide_gate_preexisting *string
}
