// decide.schema: the decide area's records. The Go is generated into
// pkg/decidewire (go generate ./pkg/decidewire).
//
// Two classes (S1). A FIXED table is a struct: small, bounded, a stable layout
// whose reader is always the same version or newer. A VARIABLE table is a
// document held by pointer, sized by its content and open-ended, with a JSON
// text form. Every table reads the same way through pkg/schemaread, in three
// forms: binary wire, padded standard base64 of it, and the JSON text.
//
// A bound is declared only where the Go code enforces one. The PR body lists,
// for every field, the schema bound and the code's (file:line, or none). A text
// the code does not bound is an unbounded string (*string), a list it does not
// bound is an unbounded list ([]T); a table holding either is variable. Only
// Usage (no bound at all), Bars and GateBars (two probabilities held by the
// readers of firstread.go and gate.go) and RawTokens (every count
// non-negative, raw.go) stay fixed.
//
// A unit that declares a variable table gets no separate fixed-form wire for
// its fixed tables at this pin (the compiler emits form 3 only when every table
// in the unit is fixed), so the fixed tables keep their class and ride form 1.
//
// Field names avoid the table's own name (C# forbids it): decision_name is the
// struct's Decision field of Decision, step the Act field of Act.
package decidewire

// ---- the decision (pkg/decide/decide.go) ----

// Question types: Choice and Noul (SPEC-NOVA-DECIDE section 2).
enum AnswerType { Choice, Noul }

// Usage: pkg/decide Usage, what one ask spent; zero is unreported. The code
// bounds neither count (decide.go Usage), so none is declared.
fixed table Usage
{
    input_tokens  int64
    output_tokens int64
}

// OptionP: one entry of an Answer's P map, an option and its probability. The
// probability must lie in [0, 1] and not be NaN (decide.go Check, record.go
// recordedProbabilities); a float64 has no declared range in v1, so the reader
// holds it.
table OptionP
{
    option *string
    p      float64
}

// Answer: pkg/decide Answer. P is an open-ended list: a choice names any number
// of options, at least two (decide.go ParseSchema), and Check sets no ceiling.
// Confidence and Method are the choice answered with no probabilities
// (SPEC-NOVA-DECIDE section 3); Check holds neither to [0, 1].
table Answer
{
    kind       AnswerType
    value      *string
    p          []OptionP
    confidence float64
    method     *string
}

// NamedAnswer: one entry of a Decision's Answers map, the question's name and
// its answer.
table NamedAnswer
{
    question *string
    answer   Answer
}

// Input: one entry of a Decision's Inputs map, an input's name and its text.
table Input
{
    key   *string
    value *string
}

// Decided: pkg/decide Decided, the decision as it rides on a card, one line
// `<option> p=<p> op=<op>`. ParseDecided refuses p outside [0, 1] and any
// field holding whitespace (attempt.go ParseDecided).
table Decided
{
    value *string
    p     float64
    op    *string
}

// ---- the schema asked, and the files and wire the decide half reads ----

// Criterion: one entry of a choice question's Criteria map, an option and what
// it means (decide.go Question).
table Criterion
{
    option  *string
    meaning *string
}

// Question: pkg/decide Question, one typed question of a schema. Problems
// (decide.go:101) holds a question to rules the schema cannot express and the
// reader states for it: instructions not empty, a choice naming at least two
// options in criteria, a noul naming none, the type one of the two. The code
// bounds no length or count, so criteria is an open-ended list. kind is the
// struct's Type field of type (a keyword of the schema language).
table Question
{
    kind         AnswerType
    instructions *string
    criteria     []Criterion
}

// NamedQuestion: one entry of a Schema's Questions map, the question's name and
// the question.
table NamedQuestion
{
    name     *string
    question Question
}

// DecideSchema: pkg/decide Schema (named so to clear the C# Schema class), the document ParseSchema decodes (decide.go:89) and
// Hash marshals (decide.go:213). Problems (decide.go:101) wants a name that is not
// blank and at least one question; both are rules the reader states.
table DecideSchema
{
    name      *string
    questions []NamedQuestion
}

// JevRequest: the body jev.go:44 marshals for an ask: the state, the model and
// the schema's questions.
table JevRequest
{
    state     *string
    model     *string
    questions []NamedQuestion
}

// JevAnswer: one answer of a Jev response (jev.go jevAnswers). kind is the wire's
// type field and stays text:
// the code reads an unknown type as an error naming it (jev.go), so the wire
// holds what was sent. confidence and noul are optional; a missing number is an
// error in the code, never a 0, so absence and zero differ.
table JevAnswer
{
    kind          *string
    choice        *string
    probabilities []OptionP
    confidence    ?float64
    noul          ?float64
}

// NamedJevAnswer: one entry of a Jev response's answers map.
table NamedJevAnswer
{
    question *string
    answer   JevAnswer
}

// JevResponse: the response jev.go:66 decodes: the answers and the usage.
table JevResponse
{
    answers []NamedJevAnswer
    usage   Usage
}

// FixedAnswer: one row of a Fixed table (backend.go FixedAnswer): a choice's
// option and its probabilities, or a noul's probability of yes. noul is
// optional: nil is a choice row.
table FixedAnswer
{
    choice *string
    p      []OptionP
    noul   ?float64
}

// NamedFixedAnswer: one entry of the answers file ParseFixed reads (backend.go:30),
// the question's name and its row.
table NamedFixedAnswer
{
    question *string
    answer   FixedAnswer
}

// FixedTable: the answers file ParseFixed decodes, {<question>: row}.
table FixedTable
{
    answers []NamedFixedAnswer
}

// ExampleLabel: the label of a grade example, flash, pro or heavy
// (gradefewshot.go GradeExampleClasses).
enum ExampleLabel { Flash, Pro, Heavy }

// Example: pkg/decide Example, one line of an examples file ParseExamples reads
// (gradefewshot.go:48). A line names its card and its heading and a label of
// the three classes; ParseExamples refuses any other, so the reader does.
table Example
{
    card    *string
    heading *string
    paths   *string
    kind    *string
    label   ExampleLabel
}

// SetEntry: one entry of a log line's Set map.
table SetEntry
{
    key   *string
    value *string
}

// LogLine: pkg/decide LogLine, the fields of one nova-sprint log --json line the
// score reads (gradescore.go:19). table_name is the struct's Table field of table.
table LogLine
{
    card       *string
    primary    *string
    table_name *string
    to         *string
    removed    bool
    set        []SetEntry
}

// LogExport: the export object ReadLog decodes (gradescore.go:52), {lines: [...]}.
table LogExport
{
    lines []LogLine
}

// ---- the gate, first-read, judgment and score structs that carry json tags ----

// Bars: pkg/decide Bars (firstread.go:30), the bounce and review bars on
// p(defect). ParseBars (firstread.go:37) holds each to [0, 1] and the review bar
// to at most the bounce bar; a float64 has no declared range in v1, so the
// reader holds both rules.
fixed table Bars
{
    bounce float64
    review float64
}

// GateBars: pkg/decide GateBars (gate.go:286), the flaky and pre-existing bars. A
// bar is a probability in [0, 1] or Unset (2.0, gate.go); ParseGateBars
// (gate.go:300) holds the range and the sum rule.
fixed table GateBars
{
    flaky        float64
    pre_existing float64
}

// GateLine: one printed line of a Failure.
table GateLine
{
    text *string
}

// Failure: pkg/decide Failure (gate.go:66), one failing test of a gate's output.
// capLines (gate.go) trims on parse, never on read, and the struct bounds no
// length or count, so lines is an open-ended list.
table Failure
{
    pkg   *string
    test  *string
    lines []GateLine
}

// Chosen: pkg/decide Chosen (judgment.go:182), what the decision chose for a card.
// act is ActApply or ActList (judgment.go); the code reads it as text.
table Chosen
{
    verb   *string
    p      float64
    fix    *string
    reason *string
    act    *string
    why    *string
}

// ClusterCard: one card of a Cluster.
table ClusterCard
{
    card *string
}

// Cluster: pkg/decide Cluster (score.go:127), one class of the findings, the count
// of score decisions at or above the bar and their cards in id order. class_name
// is the struct Class field (class is reserved in C++). The code
// bounds neither the count nor the cards.
table Cluster
{
    class_name *string
    count int64
    cards []ClusterCard
}

// ---- the record lines (pkg/decide/record.go) ----

// Decision: pkg/decide Decision as the record writes it on a decision line. The
// folded-in Outcome and Acts are never written on this line, so they are not
// fields here. The attempt decision (attempt.go ParseAttempt) is this table
// with decision_name "attempt". state is the exact text asked over, held at
// its own size; inputs and answers are open-ended lists.
table Decision
{
    id            *string
    decision_name *string
    schema        *string
    backend       *string
    at            *string
    inputs        []Input
    state         *string
    answers       []NamedAnswer
    usage         Usage
}

// Outcome: pkg/decide Outcome, what turned out to be true about a decision. It
// is attached once (record.go Attach).
table Outcome
{
    id    *string
    label *string
    note  *string
    at    *string
}

// Act: pkg/decide Act, one step of applying a decision: step is applying,
// applied or refused; op is the operation id the verbs carry.
table Act
{
    id   *string
    step *string
    op   *string
    at   *string
}

enum LineKind { Decision, Outcome, Act }

// RecordLine: the record's line (record.go line). A line is one record
// (record.go parse refuses a line holding more than one): kind names the one
// that is present, and the reader refuses a line whose other two are set.
table RecordLine
{
    kind        LineKind
    as_decision *Decision
    as_outcome  *Outcome
    as_act      *Act
}

// ---- the import (pkg/decide/import.go) ----

// JudgmentId: one judgment id an export line answers.
table JudgmentId
{
    id *string
}

// ImportLogLine: the part of a nova-sprint log --json export line the import
// reads (import.go judgmentItems): the verb and every judgment id it answers
// (the code takes every id of the line).
table ImportLogLine
{
    verb    *string
    answers []JudgmentId
}

// ImportExport: the export object judgmentItems unmarshals (import.go:167),
// {lines: [{verb, answers}]}; ImportLogLine is its inner line. The code takes
// every line, so the list is open-ended.
table ImportExport
{
    lines []ImportLogLine
}

// ---- the raw card cost (pkg/cardcost/raw.go) ----

enum Billing { Metered, Plan, Subscription }

// RawTokens: RawRecord.Tokens, the original counters; absence and zero differ
// (raw.go), so each is optional. The keys are museRawKeys; a count is a
// non-negative int64 (raw.go:55, validateRawJSON).
fixed table RawTokens
{
    input_tokens       ?int64 | min = 0, max = 9223372036854775807
    output_tokens      ?int64 | min = 0, max = 9223372036854775807
    cached_tokens      ?int64 | min = 0, max = 9223372036854775807
    cache_write_tokens ?int64 | min = 0, max = 9223372036854775807
    cache_read_tokens  ?int64 | min = 0, max = 9223372036854775807
    reasoning_tokens   ?int64 | min = 0, max = 9223372036854775807
}

// RawRecord: cardcost RawRecord. Validate (raw.go:51) holds harness to muse,
// execution to fleet, source_schema to muse-jsonl-v1, producer_version
// non-empty and billing one of the three; the reader refuses any other.
table RawRecord
{
    harness          *string
    execution        *string
    source_schema    *string
    producer_version *string
    billing          Billing
    tokens           RawTokens
}

// RawUsage: cardcost RawUsage. Validate (raw.go:47) holds version to 1 and at
// least one record; that is an equality, not a range (a range excluding zero
// needs a default that would hide an absent version), so the reader holds it and
// the declared range is the type's. The code bounds the list by bytes, never by count:
// MaxRawBytes (raw.go:21, 32768) caps the JSON envelope EncodeRaw writes
// (raw.go:72) and DecodeRaw reads (raw.go:80), so how many records fit depends
// on the size of each. The list is therefore open-ended and the table variable;
// the byte cap is held by cardcost where the envelope is written, and the golden
// test pins it at its boundary through EncodeRaw.
table RawUsage
{
    version uint32 | min = 0, max = 4294967295
    records []RawRecord
}

// ---- the card contract file (pkg/cardcontract/contract.go) ----

enum FrameKind { Work, Read }

// StagePath: one recipe file a frame's Stage names, relative to Recipes.
table StagePath
{
    path *string
}

// Frame: cardcontract Frame, the frame the member hands native as a file.
// ReadFrame (contract.go:142) refuses a kind that is not work or read and an
// empty card. The code bounds no length, count or number.
table Frame
{
    kind                    FrameKind
    card                    *string
    attempt                 int64
    tier                    *string
    model                   *string
    repo                    *string
    base_ref                *string
    stage_sha               *string
    branch                  *string
    prev_head               *string
    prev_attempt            int64
    why                     *string
    finding                 *string
    fix                     *string
    review_base             *string
    stage                   []StagePath
    recipes                 *string
    decide_bounce           *string
    decide_review           *string
    decide_gate_flaky       *string
    decide_gate_preexisting *string
}
