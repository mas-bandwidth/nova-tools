// stamp.schema: the hook lease stamp, the value of a push's lease or proof
// key in the hook record (hook package, docs/SPEC-HOOK.md): the record's
// epoch it was written under, the store's time it was written, and its
// holder. Times are int64 Unix milliseconds, never RFC 3339 text: a stamp
// that is not a stamp is refused by name instead of failing closed in a
// parse. Its Go is generated into pkg/hookwire (go generate ./pkg/hookwire).
//
// A VARIABLE table: every tool that gates reads it, across versions, so an
// older reader skips and counts a field it does not know.
//
// Absent reads as zero in a variable table, so epoch and at_ms are optionals
// whose presence the reader checks (an epoch or a time of zero is no stamp),
// and the holder is text the reader refuses when empty.
package hookwire

table Stamp
{
    // epoch: the hook record's epoch the lease or proof was written under; a
    // stamp of another epoch counts for nothing.
    epoch ?int64
    // at_ms: the store's time the stamp was written, Unix milliseconds.
    at_ms ?int64
    // by: the holder, the process that renews the lease or proved the push.
    by    string(128)
}
