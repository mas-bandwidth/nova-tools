// seatrec.schema: the seat environment, the tokens day file, the tokens bus
// roster and the secrets place receipt, as binary wire and padded standard
// base64 of that wire. Its Go is generated into pkg/seatrecwire
// (go generate ./pkg/seatrecwire).
//
// FIXED tables (schema owner rule S1): each is a bounded record the tool
// itself writes and reads back, and its reader is always the same version or
// newer. The layout is a promise to every image already written, so
// schema.lock sits beside this file and tables.baseline records the tables.
// A fixed record is at most 65536 bytes (docs/SPEC-TABLES.md §3.4). The day
// file's rows ride inside DayFile, capped so the body stays under that.
//
// Every field is a field of the Go struct it replaces and keeps its meaning.
// A length the Go code does not state is this record's fixed capacity, and
// the comment on the field says so. A value past a declared bound is refused
// by name on save and on load; nothing is clamped. No field holds a secret
// value: a secret is named, and a placed value is identified by the sealed
// file.
//
// The schema compiler takes no array of string(N), so a list of labels is an
// array of SourceLabel. A counted array is [..N] (a minimum other than zero
// is not a spelling the language has); where the Go refuses an empty list,
// the comment names that rule.
package seatrecwire

// SeatDir is one optional directory path. ? on string(N) is refused
// (docs/SPEC-TABLES.md §15), so the string is wrapped and the field that
// holds it is optional.
fixed table SeatDir
{
    text string(1024)
}

// SeatEndpoint is one optional host:port. Same wrap as SeatDir, at the
// endpoint capacity.
fixed table SeatEndpoint
{
    text string(256)
}

// SeatLogin is the login object of the seat environment (pkg/seatcred
// SeatLogin). It names a store login. When login is present, every reference
// is required (SeatEnvironment.validate, StoreLogin.missing).
fixed table SeatLogin
{
    // redis: host:port. seatEndpoint accepts a numeric port from 1 through
    // 65535 and rejects URL syntax and credential-bearing forms. The code
    // states no byte cap; 256 is the fixed capacity.
    redis string(256)
    // user: non-empty, and it holds no NUL, CR or LF (validate). No byte
    // cap; 128 is the fixed capacity.
    user string(128)
    // store: the secrets-store path. Empty is an incomplete login
    // (StoreLogin.missing). No byte cap; 1024 is the fixed capacity.
    store string(1024)
    // as_name: the seat JSON key "as". "as" is a reserved word in a target
    // the compiler refuses (SPEC §4.6), so the table spells as_name and the
    // JSON name stays "as". Empty is an incomplete login.
    as_name string(128) | json = "as"
    // key: the key path. Empty is incomplete. No byte cap; 1024 is the
    // fixed capacity.
    key string(1024)
    // sops: the sops path. Empty is incomplete. No byte cap; 1024 is the
    // fixed capacity.
    sops string(1024)
    // secret: the sealed secret's name, never its value. The seat record
    // requires ^[A-Z_][A-Z0-9_]*$ (environmentSecretName). No byte cap; 128
    // is the fixed capacity.
    secret string(128)
}

// SeatEnvironment is the v1 seat record (seat-environment.json): which
// sealed file a seat uses and where. LoadSeatEnvironment accepts version 1
// only. A range that excludes zero carries a default inside the range, so
// the zero form of the field is not out of range on every read.
fixed table SeatEnvironment
{
    // version: LoadSeatEnvironment accepts only 1.
    version int32 = 1 | min = 1, max = 1
    // forge_identity: an absolute directory, when set (validate checks
    // filepath.IsAbs and that the path is a directory). Absent is the key
    // missing. No byte cap; 1024 is the fixed capacity (SeatDir).
    forge_identity ?SeatDir
    // environmentKeyAllowed allows exactly these three keys, each a
    // host:port under the same rule as SeatLogin.redis (seatEndpoint).
    // Absent is the key missing from the environment object. The Go field
    // is a map; the allowlist is closed, so the table is these three fields.
    nova_sprint_redis  ?SeatEndpoint
    nova_sprint_server ?SeatEndpoint
    nova_bus_redis     ?SeatEndpoint
    // login: absent, or one SeatLogin. validate requires every reference
    // when it is present.
    login ?SeatLogin
}

// SourceLabel is one label in a sources cell. The cell is a comma-separated
// list (DayFile.Render, ParseDayFile). The code states no length cap; 64 is
// the fixed capacity.
fixed table SourceLabel
{
    text string(64)
}

// DayLine is one day-file row (internal/tokens DayRow). A count whose set
// flag is false is the dash cell: a type the source did not report, not a
// zero. ParseDayFile refuses a negative count and a cell that is neither a
// non-negative integer nor "-". Counts.Set saturates at math.MaxInt64, which
// is a legal value; the upper end of each count is that width, and a bound
// on the storage limit is a check that cannot fire.
fixed table DayLine
{
    // date: YYYY-MM-DD. ValidDay requires length 10 and a real calendar day.
    // The declared bound is the length.
    date string(10)
    // model, repo: no byte cap in ParseDayFile. 128 is the fixed capacity.
    model string(128)
    repo  string(128)
    input          int64 | min = 0, max = 9223372036854775807
    input_set      bool
    output         int64 | min = 0, max = 9223372036854775807
    output_set     bool
    cache_write     int64 | min = 0, max = 9223372036854775807
    cache_write_set bool
    cache_read      int64 | min = 0, max = 9223372036854775807
    cache_read_set  bool
    reasoning      int64 | min = 0, max = 9223372036854775807
    reasoning_set  bool
    // rough: ParseDayFile reads it with strconv.Atoi and refuses a negative.
    // Stored as int64, the width of the other counts.
    rough int64 | min = 0, max = 9223372036854775807
    // basis: "utc" (internal/tokens UTC) or a zone name with no whitespace
    // (ValidZone). No byte cap; 64 is the fixed capacity.
    basis string(64)
    // sources: the row's sources cell. ParseDayFile refuses an empty cell.
    // The code states no count cap; 16 is the fixed capacity. A counted
    // array has no minimum other than zero, so the empty-cell refusal stays
    // the Go rule named here.
    sources [..16]SourceLabel
}

// DayFile is one tokens day file (internal/tokens DayFile): the version
// line and its rows. ParseDayFile requires day, at, build and turns on the
// version line, and refuses a file with no rows. The code caps a source
// read at maxSourceBytes (64 MiB), which is a file cap, not a field. The
// legacy twelve-column units header is reader-only and is not a field.
fixed table DayFile
{
    // day: the version line's day, YYYY-MM-DD. ValidDay requires length 10.
    day string(10)
    // at: the version line's at token. The code requires the key and does
    // not parse the stamp. No byte cap; 64 is the fixed capacity.
    at string(64)
    // build: the version line's build id. Required. No byte cap; 64 is the
    // fixed capacity.
    build string(64)
    // turns: a non-negative count, or absent for the dash. ParseDayFile
    // reads a present value with strconv.Atoi and refuses a negative and an
    // empty value. Absent is the dash; a present 0 is a counted zero.
    turns ?int64 | min = 0, max = 9223372036854775807
    // sources: the version line's sources list. The key may be absent,
    // which is an empty list. No count cap; 16 is the fixed capacity.
    sources [..16]SourceLabel
    // rows: ParseDayFile refuses a file with no rows. The code states no
    // row cap. 24 is the fixed capacity (S1): a month of rows is larger
    // than one fixed body, and 24 of this width stays under 65536 bytes.
    rows [..24]DayLine
}

// Participant is one entry of the roster participants.json reads
// (internal/tokens laneNames). name is the friend's name. lane is
// "from-<slug>"; a lane without that prefix, or with an empty slug, is
// skipped. The code states no byte cap. The slug is a bus name of at most
// 64 bytes (schemas/bus Name); 80 covers the "from-" prefix plus that name.
fixed table Participant
{
    name string(64)
    lane string(80)
}

// BusRoster is the tokens bus record at internal/tokens/bus.go (laneNames):
// the participants roster. A roster that yields no lane is refused. The code
// states no count cap; 64 is the bus envelope's recipient-list bound
// (schemas/bus Envelope) and this roster's fixed capacity. The counted array
// has no minimum other than zero, so the empty-roster refusal stays the Go
// rule named here.
fixed table BusRoster
{
    participants [..64]Participant
}

// PlacedReceipt is one secrets place receipt line (placedReceipt): what was
// placed, identified by the sealed file. The line is secret, path, file,
// head, blob, stamp. Unknown and Legacy are derived on read and are not
// written. An empty file, head or blob is the dash the line prints.
fixed table PlacedReceipt
{
    // secret: the secret's name. place requires ^[A-Z][A-Z0-9_]*$
    // (IsValidEnvVar) and refuses empty. No byte cap; 128 is the fixed
    // capacity. The value is not a field.
    secret string(128)
    // path: the remote path. The code states no byte cap; 1024 is the
    // fixed capacity.
    path string(1024)
    // file: the seat file name (<seat>.yaml) the value was sealed in.
    // Empty is the dash. No byte cap; 256 is the fixed capacity.
    file string(256)
    // head: the store HEAD when place started. isValidHexSHA accepts 40
    // or 64 hex characters; empty is the dash. 64 is that maximum.
    head string(64)
    // blob: the git blob id of the sealed file's bytes (GitBlobSHA1), 40
    // hex characters. Empty is the dash. 40 is that width.
    blob string(40)
    // stamp: time.RFC3339, which formats at most 25 bytes. place writes
    // one on every receipt.
    stamp string(25)
}
