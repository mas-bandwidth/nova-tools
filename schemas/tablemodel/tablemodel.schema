// tablemodel.schema: the records of the table model's checks (internal/tablemodel)
// and the convergence verb's remembered state (internal/converge), as binary
// wire and padded standard base64 text. Its Go is generated into
// pkg/tablemodelwire (go generate ./pkg/tablemodelwire).
//
// Every record here is a FIXED table (schema owner rule S1: a struct, small,
// bounded, stable layout), and a unit holding a fixed table holds no variable
// one (the compiler emits the fixed form only for a unit that is fixed
// throughout), so ModelTrace, whose head carries a list that grows with the
// repository, is the VARIABLE table of the sibling area schemas/tablemodeltrace.
// The layout of a fixed table is a promise to every image already written, so
// schema.lock sits beside this file and tables.baseline records the tables. A
// fixed record is at most 65536 bytes (docs/SPEC-TABLES.md §3.4), so a whole
// retained trace is one ModelTrace head (tablemodeltrace), then the initial
// ModelState, then its steps as a batch of ModelTraceStep records (a fixed
// save and load take a batch).
//
// Every field is a field of the Go struct it replaces and keeps its meaning.
// The Go structs declare no length or count themselves; the bound of each
// field here is the bound of the thing it holds, and the comment on it names
// the rule:
//
//   - the model universe: capture.go's tables, epochs, rowKeys, cols, writers
//     and members (two tables, two epochs, two rows, three columns, two
//     writers, three members) fix how many physical tables, rows, cells,
//     bindings, data and placements a State can hold, and each name is at
//     most 16 bytes (t1, r1, c1, m1, w1, "external");
//   - the fixture: capture.go's Actions() (32 calls, at most 5 arguments, the
//     longest a JSON object of about 300 bytes) fixes a step and a trace;
//   - the change stream: table.lua's XADD (line 1098) writes at most 12
//     fields beside the id, so an Event holds 16;
//   - the verb set: steps.go's Step fields and witnesses.go's findings are
//     short names;
//   - converge.go's seven streams (LANDING, CLASSES, SCRIPTS, PRS, EDGES,
//     FLEET, LEDGER) fix the convergence state.
//
// A value past a bound is refused by name on save and on load; nothing is
// clamped. Maps (Event, State.Seen, Trace.ModelSHA256, converge State.Streams)
// are bounded arrays of key and value entries in the key's sorted order, the
// order the JSON form writes them.
package tablemodelwire

// ModelArg is one argument of a call: a name or a JSON object, 512 bytes (the
// longest in the fixture, bind's options with its fields, is about 300). The
// schema compiler takes no array of string(N), so the string is wrapped in a
// type.
fixed table ModelArg
{
    text string(512)
}

// ModelDetail is one key=value detail of a replay event (an element of Fields).
fixed table ModelDetail
{
    text string(256)
}

// ModelPhys is one physical table: a table name at an epoch (state.go Phys,
// JSON [table, epoch]). The field is table_name because table is a keyword of
// the schema language. table_name: capture.go tables are t1 and t2, 16 bytes.
// epoch: a counter that starts at 1.
fixed table ModelPhys
{
    table_name string(16)
    epoch      int32 | min = 0, max = 1000000
}

// ModelCell is a cell of a physical table, or one of the two sentinels
// (state.go Cell, JSON [[table, epoch], row, column]). row and col:
// capture.go rowKeys and cols are two characters; the sentinels are "external"
// and "none", 16 bytes.
fixed table ModelCell
{
    p   ModelPhys
    row string(16)
    col string(16)
}

// ModelRowAt is a row present in a physical table (state.go RowAt).
fixed table ModelRowAt
{
    p   ModelPhys
    row string(16)
}

// ModelBind is a cell bound to a target (state.go Bind).
fixed table ModelBind
{
    cell   ModelCell
    target ModelCell
}

// ModelDatum is a member of a cell with its score (state.go Datum). member:
// capture.go members m1..m3, 16 bytes. score: a sorted-set score the fixture
// sets to a small integer; capture.go atoi reads it into an int.
fixed table ModelDatum
{
    cell   ModelCell
    member string(16)
    score  int32
}

// ModelLocation is where a member is in one physical table (state.go Location).
fixed table ModelLocation
{
    p    ModelPhys
    cell ModelCell
}

// ModelPlacement is the place of one member in every physical table (state.go
// Placement). locations: one per live physical table, at most the universe's
// tables times epochs (2 x 2 = 4).
fixed table ModelPlacement
{
    member    string(16)
    locations [..4]ModelLocation
}

// ModelSeen is one entry of State.Seen: the epoch a writer last read. writer:
// capture.go writers are w1 and w2, 16 bytes.
fixed table ModelSeen
{
    writer string(16)
    epoch  int32 | min = 0, max = 1000000
}

// ModelState is everything the model observes of the store at one moment
// (state.go State). The bounds are the universe's: live is tables x epochs
// (4); rows is live x rowKeys (8); binds is the cells (live x rowKeys x cols =
// 24, plus the external cell) a cell can be bound from: 25; data is cells x
// members (25 x 3): 75; place is one entry per member: 3; seen is one entry per
// writer: 2. active: the active epoch.
fixed table ModelState
{
    live   [..4]ModelPhys
    rows   [..8]ModelRowAt
    binds  [..25]ModelBind
    data   [..75]ModelDatum
    place  [..3]ModelPlacement
    active int32 | min = 0, max = 1000000
    seen   [..2]ModelSeen
}

// ModelAction is one controlled call of the trace (capture.go Action): a verb
// of table.lua, its arguments and the writer making it. verb: a table.lua verb
// name or one of the two model-only steps (24 bytes). args: at most 5 in the
// fixture (cell_move). actor: w1 or w2, 16 bytes.
fixed table ModelAction
{
    verb  string(24)
    args  [..5]ModelArg
    actor string(16)
}

// ModelEventField is one field of a committed receipt (capture.go Event, a
// map[string]string): an entry of a table's change stream. key: table.lua's
// field names (verb, args, epoch, rev_before, rev_after, actor, fence, idem,
// cells, members, outcome, renamed_keys, id), 24 bytes. value: the longest is
// the JSON of the arguments, about 400 bytes with its escapes, 512 here.
fixed table ModelEventField
{
    key   string(24)
    value string(512)
}

// ModelEvent is a committed receipt: the fields of one entry of a table's
// change stream, and its id (capture.go Event). At most 16 fields: the stream
// entry carries 12, and the id is added.
fixed table ModelEvent
{
    fields [..16]ModelEventField
}

// ModelTraceStep is one step of the retained trace (replay.go TraceStep): the
// call, whether it was refused, its receipt, the model action that performs it
// and the store state after it. refused: absent when the step was one of the
// two model-only steps (the Go pointer is nil), present true or false
// otherwise. hasReceipt is true when the step carries a receipt (the Go map is
// not nil); a refusal has none. model: ActionTLA's output, 512 bytes for the
// longest row_add or bind in the fixture.
fixed table ModelTraceStep
{
    verb       string(24)
    args       [..5]ModelArg
    actor      string(16)
    refused    ?bool
    hasReceipt bool
    receipt    ModelEvent
    model      string(512)
    state      ModelState
}

// ModelFinding is one replayed witness or control (witnesses.go Finding).
// name: a finding's short name; result: "confirmed" or "pass"; text: one
// sentence, 512 bytes.
fixed table ModelFinding
{
    name   string(64)
    result string(32)
    text   string(512)
}

// ModelReplayEvent is one completed part of the replay (replay.go
// ReplayEvent). step: capture, receipt-replay, mutation-controls,
// tlc-execution or tlc-mutated-observation; verdict: pass or
// expected-mutation-failure; fields: key=value details, at most 8 of 256 bytes.
fixed table ModelReplayEvent
{
    step    string(64)
    verdict string(64)
    fields  [..8]ModelDetail
}

// ModelStep is one configuration of a suite and the result it must reach
// (steps.go Step). name and module: a configuration base name and its .tla
// file; kind: pass, invariant or action; property: the violated invariant's
// name, empty for a pass; met: one of the Verdict constants (at most 32
// bytes). workers: TLC workers, 1 to 1024.
fixed table ModelStep
{
    name     string(64)
    module   string(96)
    workers  int32 | min = 0, max = 1024
    kind     string(16)
    property string(64)
    met      string(32)
}

// ModelViolation is one property TLC said is violated (pkg/tlc Violation).
// kind: "Invariant", "Action property" or "Temporal property"; name: empty when
// TLC does not name a temporal property.
fixed table ModelViolation
{
    kind string(32)
    name string(128)
}

// ModelOutcome is what one TLC output says (pkg/tlc Outcome). generated and
// distinct: the state counts as digits only, or "-" when TLC printed none
// (a count past 2^64 is 20 digits). violations: one per violated property, at
// most 16.
fixed table ModelOutcome
{
    completed    bool
    generated    string(24)
    distinct     string(24)
    violations   [..16]ModelViolation
    initialState bool
}

// ModelStepResult is what one step did (steps.go StepResult). verdict: one of
// the Verdict constants (at most 32 bytes). code: TLC's exit status (0 to 255).
// seconds: the step wall time in nanoseconds, a time.Duration, at most one day. log: the
// path of the step's TLC log (at most 1024 bytes, the longest path the
// disposable directory allows).
fixed table ModelStepResult
{
    step    ModelStep
    verdict string(32)
    ok      bool
    code    int32 | min = 0, max = 255
    seconds int64 | min = 0, max = 86400000000000
    outcome ModelOutcome
    log     string(1024)
}

// ConvergeStreamEntry is one stream the verb remembers (converge.go State.Streams
// is a map keyed by stream name, written here in the key's sorted order):
// StreamState is the value it read (now), when it read it (at, an RFC 3339
// instant of at most 40 bytes) and how many consecutive ticks that stream has
// been widening (widening, JSON widening_ticks). name: LANDING, CLASSES,
// SCRIPTS, PRS, EDGES, FLEET or LEDGER, 32 bytes leaves room.
fixed table ConvergeStreamEntry
{
    name     string(32)
    now      float64
    at       string(40)
    widening int32 | min = 0, max = 1000000
}

// ConvergeState is the whole memory of the convergence verb (converge.go
// State): one entry per stream, 7 today and 16 here.
fixed table ConvergeState
{
    streams [..16]ConvergeStreamEntry
}
