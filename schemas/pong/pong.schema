// pong.schema: the friend pong, the answer a friend gives to a liveness
// challenge (nova-friend pong), as it travels in a bus body. Its Go is
// generated into pkg/pongwire (go generate ./pkg/pongwire).
//
// A VARIABLE table: friends exchange it, so an older reader may meet a newer
// writer's pong, and a variable table skips and counts a field it does not
// know instead of refusing the message.
//
// There is no version or kind field: the table wire's form byte versions the
// file, and a field's identity is the hash of its name.
//
// Absent reads as zero in a variable table, so every field a liveness count
// reads is either text a reader refuses when empty (friend_name, nonce) or an
// optional (?T) whose presence the reader checks: a zero queue is a real
// answer, an absent queue is a malformed pong. The runtime clamps an over-bound
// value and counts it; a reader refuses every clamp.
package pongwire

table Pong
{
    // friend_name: the answering friend's name, as nova-bus names a sender
    // (64 bytes). Spelled friend_name because friend is a reserved word in
    // C++ and the compiler refuses it in every language's unit.
    friend_name string(64)
    // nonce: the challenge being answered. Today six characters of [a-z0-9] or
    // six clock digits; 32 leaves room for a 16-byte hex nonce.
    nonce   string(32)
    // queue: cards waiting for the friend; working: lanes working now;
    // width: the friend's lane width.
    queue   ?uint32 | min = 0, max = 100000
    working ?uint32 | min = 0, max = 10000
    width   ?uint32 | min = 0, max = 1024
    // sent_ms: the friend's clock when it wrote the pong, Unix milliseconds.
    sent_ms ?int64
}
