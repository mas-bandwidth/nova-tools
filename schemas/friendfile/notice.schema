// notice.schema: the saved notice file a native receiver reads (pkg/harness/notice
// Envelope, notice.go:519-535, written by Core.save at :538-555 and by Disk.Save,
// store.go:119-132), as binary wire, padded standard base64 and JSON text. Its Go is
// generated into pkg/friendfilewire (go generate ./pkg/friendfilewire).
//
// Every table here is VARIABLE (schema owner rule S1): the file is bounded external
// data every native receiver of any version reads, and a record is FIXED only where
// every bound it declares is one the code enforces. The one bound the code enforces
// on the file is MaxSaved, 64 KiB of the whole saved file (notice.go:52, checked at
// :548 and store.go:120), which bounds the file and no field, so it is not declared
// here. The challenge and the recovery messages are bus messages (pkg/bus Message,
// bus.go:77-113) carried in the Go struct's own JSON keys, which are the Go field
// names because the struct has no tags; the bounds below are the bus's own on a
// message at send: a name is at most MaxName bytes (bus.go:37, CheckName :64-73), a
// token at most MaxToken (token.go:32, :53) and a body at most MaxBody (bus.go:36,
// :463). The lists have no count bound in the code, so they are open lists. A time is
// the text time.Time writes (RFC 3339 with nanoseconds), a duration is the integer
// nanoseconds time.Duration writes, and a Go int is int64. A list of text is a list of
// tables, since the schema compiler takes no list of text.
package friendfilewire

// NoticeName is one name of a sender or a recipient: lowercase letters, digits and
// hyphens, at most pkg/bus MaxName (64) bytes (bus.go:37, :64-73; the character set
// is the bus's check, not a bound of the length).
table NoticeName
{
    s string(64)
}

// NoticeMark is one pkg/bus Mark (receipt.go:21-24) a message carries; its keys are the
// Go field names.
table NoticeMark
{
    key     *string | json = "Key"
    field   *string | json = "Field"
    value   *string | json = "Value"
    clear   bool    | json = "Clear"
    forward bool    | json = "Forward"
    once    bool    | json = "Once"
}

// NoticeMessage is the bus message a notice carries (pkg/bus Message, bus.go:77-113),
// under the Go field names the struct serializes. from, each name of to and cc, token
// and body carry the bus's bounds at send (see the head of this file); every other text
// is unbounded because the bus checks none (kind is checked against its list, :395, but
// the stored text is read as it stands).
table NoticeMessage
{
    model_activity bool          | json = "ModelActivity"
    id             *string       | json = "ID"
    from           string(64)    | json = "From"
    to             []NoticeName  | json = "To"
    cc             []NoticeName  | json = "CC"
    subject        *string       | json = "Subject"
    re             *string       | json = "Re"
    card           *string       | json = "Card"
    head           *string       | json = "Head"
    kind           *string       | json = "Kind"
    at             *string       | json = "At"
    body           string(1048576) | json = "Body"
    wait           int64         | json = "Wait"
    due            *string       | json = "Due"
    token          string(128)   | json = "Token"
    once           *string       | json = "Once"
    marks          []NoticeMark  | json = "Marks"
}

// NoticeReceiver is the envelope's local_receiver block (notice.go:520-525): who the
// notice is for and the two instructions written into it; unbounded text.
table NoticeReceiver
{
    identity    *string
    redis       *string
    proof       *string
    acknowledge *string
}

// NoticeEnvelope is the saved notice file. challenge is absent when the notice holds no
// challenge; the recovery fields are absent when it holds no recovery (Core.save
// :543-545). messages is the count of ordinary bus messages since the last notice. The
// hook_role text is a hook Role (hook.go:42-52); the saver writes any role the hook
// parsed and a reader of any version meets a newer one, so it is text, not an enum.
table NoticeEnvelope
{
    local_receiver      NoticeReceiver
    saved_at            *string
    hook_epoch          int64
    hook_role           *string
    event_id            *string
    challenge           *NoticeMessage
    messages            int64
    senders             []NoticeName
    recovery_since      *string
    recovery_coverage   *string
    recovery_messages   []NoticeMessage
    possible_duplicates bool
}
