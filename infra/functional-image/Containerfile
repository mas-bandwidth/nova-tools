# nova-functional: the functional-tier image.
#
# One image, one job: run the functional tests of this repository (the files
# behind `//go:build functional`) in a container that owns every process, port,
# System V shared memory segment and temp file the run makes. The fixtures start
# redis-server and postgres as child processes of the test binary; here they are
# children inside the container, and removing the container removes them.
#
# Every input is pinned, so two builds give the same image contents:
#   - the base image, by its multi-arch index digest;
#   - the distribution's packages, by a dated snapshot of the archive;
#   - the Go toolchain, by the version go.mod pins and the vendor's sha256;
#   - redis-server, by a source release and the project's published sha256.
# infra/functional-image/README.md has the build, manifest and run commands.
# The class test in internal/ci (TestFunctionalImage*) holds this file to
# binaries.txt, to the base digest and to go.mod's Go version.
#
# Nothing secret is baked in. The source tree, the Go build cache and the Go
# module cache arrive as mounts at run time.

# ubuntu:24.04, the multi-arch index digest. Its Postgres is 16, which the
# fixtures search first (/usr/lib/postgresql/16/bin) and which the CI installer
# (.github/scripts/install-postgres.sh) installs; no NOVA_PG_BIN is needed.
ARG BASE=docker.io/library/ubuntu@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3

# ---- apt-base: the archive pinned to a snapshot, and TLS roots ----
FROM ${BASE} AS apt-base
# The archive as it stood at this instant (snapshot.ubuntu.com). Changing it is
# the one way the package versions move; the manifest shows what moved.
ARG APT_SNAPSHOT=20260928T000000Z
# A build argument, not an ENV, so it is not in the image's environment.
ARG DEBIAN_FRONTEND=noninteractive
# The base has no TLS roots, so the first install reads the snapshot without
# verifying the peer. The archive's own signature (Signed-By) vouches for every
# package, but Ubuntu's release files carry no Valid-Until, so on that one call
# an attacker in the path could replay an older, genuinely signed release, and
# the snapshot instant would not hold for what it installed. The step records
# the installed versions before that call, refreshes the index with TLS
# verified once ca-certificates is there, and fails the build when any package
# the first call installed or changed differs from the verified index's
# candidate. It detects a replay; it does not stop the replayed packages' own
# install scripts from having run in this build stage. The base image's other
# packages are the base image's, pinned by its digest, and are not compared.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.sources \
 && printf '%s\n' \
      'Types: deb' \
      "URIs: https://snapshot.ubuntu.com/ubuntu/${APT_SNAPSHOT}/" \
      'Suites: noble noble-updates noble-security' \
      'Components: main universe' \
      'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/snapshot.sources \
 && dpkg-query -W -f='${binary:Package} ${Version}\n' | sort > /tmp/before \
 && apt-get -o Acquire::https::Verify-Peer=false update \
 && apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates \
 && apt-get update \
 && dpkg-query -W -f='${binary:Package} ${Version}\n' | sort > /tmp/after \
 && comm -13 /tmp/before /tmp/after | while read -r pkg ver; do \
      cand="$(apt-cache policy "${pkg}" | sed -n 's/^  Candidate: //p')"; \
      test "${ver}" = "${cand}" || { echo "${pkg} ${ver} was installed without TLS checks; the snapshot has ${cand}" >&2; exit 1; }; \
    done \
 && rm -rf /var/lib/apt/lists/* /tmp/before /tmp/after

# ---- fetch: the vendor binaries, each checked against its sha256 ----
# Kept in its own stage so curl is not in the image.
FROM apt-base AS fetch
ARG DEBIAN_FRONTEND=noninteractive
# The exact toolchain go.mod pins, per architecture. GO_VERSION equals go.mod's
# `go` line (a class test holds it).
ARG GO_VERSION=1.26.6
ARG GO_SHA256_AMD64=708effb774be8237570d0add163225abbdfaf4fca28b2611df167beba4feef89
ARG GO_SHA256_ARM64=d0507e9e9d7fe012aae570108cbd76c15de879e17130ab8cb90d4d7445cb1f2e
# sops and age-keygen at the minimums docs/SPEC-SECRETS.md pins ("Dependencies,
# pinned"): the nova-secrets functional tests seal and open real files with
# them. sops publishes a checksums file; age's sums are the release archives'
# sha256, which are the digests GitHub shows for each asset.
ARG SOPS_VERSION=3.13.3
ARG SOPS_SHA256_AMD64=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
ARG SOPS_SHA256_ARM64=53b0abacd38ef1b12a66d6c100956691b9cefce018d91f81e73ddf7438b94d77
ARG AGE_VERSION=1.3.2
ARG AGE_SHA256_AMD64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
ARG AGE_SHA256_ARM64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*
RUN arch="$(dpkg --print-architecture)" \
 && case "${arch}" in \
      amd64) go_sum="${GO_SHA256_AMD64}" && sops_sum="${SOPS_SHA256_AMD64}" && age_sum="${AGE_SHA256_AMD64}" ;; \
      arm64) go_sum="${GO_SHA256_ARM64}" && sops_sum="${SOPS_SHA256_ARM64}" && age_sum="${AGE_SHA256_ARM64}" ;; \
      *) echo "no checksums for ${arch}" >&2 && exit 1 ;; \
    esac \
 && fetch() { curl -fsSL -o "$1" "$2" && printf '%s  %s\n' "$3" "$1" | sha256sum -c -; } \
 && fetch /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${arch}.tar.gz" "${go_sum}" \
 && fetch /tmp/sops "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.${arch}" "${sops_sum}" \
 && fetch /tmp/age.tgz "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-${arch}.tar.gz" "${age_sum}" \
 && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm -rf /usr/local/go/test \
 && install -m 0755 /tmp/sops /usr/local/bin/sops \
 && tar -C /tmp -xzf /tmp/age.tgz age/age age/age-keygen \
 && install -m 0755 /tmp/age/age /tmp/age/age-keygen /usr/local/bin/

# ---- redis-build: redis-server and redis-cli from the pinned source release ----
# Redis 8, the wording the tests expect (internal/redisfn's test texts are
# Redis 8's); Redis 8.10.2 is also
# the release .github/scripts/install-redis-server.sh builds where the
# distribution has none. This ARG is the repository's one Redis version:
# internal/ci's TestRedisIsOneVersionEverywhere holds every other place that
# names one to it.
FROM apt-base AS redis-build
ARG DEBIAN_FRONTEND=noninteractive
ARG REDIS_VERSION=8.10.2
ARG REDIS_SHA256=b9ffee226b5eecdba98a679260dad764b2a4ebd90dce4ad5ac9e9f3eef9c02b3
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl \
 && curl -fsSL -o /tmp/redis.tar.gz "https://download.redis.io/releases/redis-${REDIS_VERSION}.tar.gz" \
 && printf '%s  /tmp/redis.tar.gz\n' "${REDIS_SHA256}" | sha256sum -c - \
 && tar -C /tmp -xzf /tmp/redis.tar.gz \
 && make -C "/tmp/redis-${REDIS_VERSION}" -j"$(nproc)" redis-server \
 && make -C "/tmp/redis-${REDIS_VERSION}" -j"$(nproc)" redis-cli \
 && install -m 0755 "/tmp/redis-${REDIS_VERSION}/src/redis-server" "/tmp/redis-${REDIS_VERSION}/src/redis-cli" /usr/local/bin/ \
 && /usr/local/bin/redis-server --version \
 && rm -rf /var/lib/apt/lists/* /tmp/redis*

# ---- the image ----
FROM apt-base
ARG DEBIAN_FRONTEND=noninteractive
ARG BENCH_UID=10001

# Every external program the functional tier runs is here; binaries.txt names
# each one and what carries it. procps is ps, kill and sysctl; python3 runs a
# stub the swarm timeout test writes; sqlite3 is the usage store's reader.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git lsof make postgresql-16 procps python3 sqlite3 \
 && rm -rf /var/lib/apt/lists/* \
 # the package makes a cluster and a service; the fixtures make their own
 && rm -rf /var/lib/postgresql/16/main /etc/postgresql/16/main \
 # and the ssl-cert package's generated TLS private key, which nothing here uses
 && rm -f /etc/ssl/private/ssl-cert-snakeoil.key

COPY --from=redis-build /usr/local/bin/redis-server /usr/local/bin/redis-cli /usr/local/bin/
COPY --from=fetch /usr/local/go /usr/local/go
COPY --from=fetch /usr/local/bin/sops /usr/local/bin/age /usr/local/bin/age-keygen /usr/local/bin/
RUN ln -s /usr/local/go/bin/go /usr/local/bin/go \
 && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

RUN useradd --uid "${BENCH_UID}" --create-home --home-dir /home/bench --shell /bin/bash bench \
 && mkdir -p /gocache /gomodcache /src \
 && chown bench:bench /gocache /gomodcache

# NOVA_CI=1 is the variable the fixtures read for "a missing dependency fails
# the test and never skips it". NOVA_FUNCTIONAL_RUN=container marks a run inside
# this image; NOVA_CI is also set on runs that are not in a container, so it
# cannot say that. GOTOOLCHAIN=local: never fetch a toolchain. GOPROXY=off: the
# module cache is filled by a separate networked step and mounted read-only, so
# a missing module fails at once and names the module.
ENV PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
    HOME=/home/bench \
    LANG=C.UTF-8 \
    GOCACHE=/gocache \
    GOMODCACHE=/gomodcache \
    GOTOOLCHAIN=local \
    GOPROXY=off \
    GOFLAGS=-buildvcs=false \
    NOVA_CI=1 \
    NOVA_FUNCTIONAL_RUN=container

# The manifest: what this build contains, one line each, so a rebuild can be
# compared by diff. Printed by `podman run --rm <image> cat /image-manifest.txt`.
RUN { \
      echo "base: $(sed -n 's/^VERSION=//p' /etc/os-release | tr -d '"') (index digest in the Containerfile)"; \
      echo "apt snapshot: $(sed -n 's#.*ubuntu/\([0-9TZ]*\)/.*#\1#p' /etc/apt/sources.list.d/snapshot.sources)"; \
      echo "go: $(go version)"; \
      echo "redis-server: $(redis-server --version | sed 's/ build=.*//')"; \
      echo "redis-cli: $(redis-cli --version)"; \
      echo "postgres: $(/usr/lib/postgresql/16/bin/postgres --version)"; \
      echo "git: $(git --version)"; \
      echo "make: $(make --version | head -n 1)"; \
      echo "python3: $(python3 --version)"; \
      echo "sqlite3: $(sqlite3 --version | cut -d' ' -f1-2)"; \
      echo "sops: $(sops --version --disable-version-check | head -n 1)"; \
      echo "age-keygen: $(age-keygen --version)"; \
      echo "packages:"; \
      dpkg-query -W -f='  ${Package} ${Version}\n' | sort; \
    } > /image-manifest.txt

USER bench
WORKDIR /src
CMD ["bash"]
