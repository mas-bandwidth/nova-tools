// fleet/tailnet-policy.hujson -- the tailnet policy of the node "rowan", as code.
//
// GENERATED by `nova-pulse fleet net init`; edit it here, never in the admin console.
// The console is not the source of truth: this file is, and .github/workflows/tailnet-acl.yml
// runs `tailscale acl test` on every pull request and applies it on the default branch.
//
// One tailnet per NODE (Glenn, 2026-09-18). Cross-node reach is a Tailscale node share,
// one machine offered into another node's tailnet and written in the machines registry as
// `shared-from:<node>`. There is no merged tailnet, and there is no rule here that reaches
// another node: the bus (git) is the federation.
//
// Everything below comes from the machines registry's ROLES. A machine's role decides what
// it may reach and what may reach it; nothing is written per machine, so a new bench needs
// no edit here at all -- it needs its tag.
{
  // The groups. `group:owners` is the node's own people: the one source that reaches the
  // coordination machine, which is where a friend's window and its whole context live.
  "groups": {
    "group:owners": ["glenn@mas-bandwidth.com"],
  },

  // Who may apply a tag. A machine is tagged when it joins (`tailscale up --advertise-tags`),
  // and a tagged machine's key never expires, which is why R7 can turn expiry off by tag
  // rather than per machine in the console.
  "tagOwners": {
    "tag:bench": ["group:owners"],
    "tag:bud": ["group:owners"],
    "tag:coordination": ["group:owners"],
    "tag:runner": ["group:owners"],
    "tag:services": ["group:owners"],
  },

  // The ACL. Tailscale denies by default: a destination no rule names is reachable by
  // nothing, and that default is doing real work below -- it is the whole of R3.
  "acls": [
    // R5: a bud -- a person's own laptop -- reaches the benches over ssh and NOTHING else. It is not a bench, it runs no card, and it has no reason to reach the coordination machine, a runner host or the stack.
    {"action": "accept", "src": ["tag:bud"], "dst": ["tag:bench:22"]},
    // Benches reach each other over ssh: that is the swarm, the mirror fetch and the work steal.
    {"action": "accept", "src": ["tag:bench"], "dst": ["tag:bench:22"]},
    // R11: the stack is reachable FROM THE BENCHES ON NAMED PORTS ONLY (3100 Loki, 3000 Grafana, 6379 Redis). Not on ssh: a bench pushes logs and metrics, it does not administer the services host.
    {"action": "accept", "src": ["tag:bench"], "dst": ["tag:services:3100", "tag:services:3000", "tag:services:6379"]},
    // R12: the coordination machine accepts the node's OWN people and nobody else. No bench, no bud, no runner host, and no shared machine from another node: a friend's window is the one place that holds its whole context.
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:coordination:*"]},
    // R16: the node's own people reach EVERY machine they own, a runner host included. Glenn, 2026-09-18, travelling: `I want to work with all friends, including keeper you and all fleet machines from the air with no restrictions.` R3 is about what the tailnet's TAGGED things may reach -- seats, buds and benches -- never about the people whose tailnet it is. NOTE that this rule reaches an owner's device only while it is UNTAGGED: a laptop that joined with --advertise-tags=tag:bud is a bud and gets the bud's one destination.
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:bench:*", "tag:bud:*", "tag:coordination:*", "tag:runner:22", "tag:services:*"]},
    // R3: no rule above lets anything TAGGED -- a bud, a bench, a seat's machine -- reach
    // tag:runner. A runner host talks OUT to the forge and that is the whole of its network
    // life; the lock of 2026-09-18 says runner hosts are CI-only, and this is that lock
    // written where the packets are. The one rule that does reach it is the owners' rule
    // just above, which is a person and not a workload. A rule added here would undo the
    // lock silently, which is why the tests below assert the denials rather than trusting
    // an absence.
  ],

  // R6: Tailscale SSH. The tailnet identity IS the authorization, so no authorized_keys is
  // distributed to any machine and no key has to be rotated when a person leaves: the
  // policy is edited here and the next connection is refused.
  "ssh": [
    // R16: the node's own people, to EVERY machine they own, as any user, with no check.
    // Glenn travelling is the case this is for: an owner at an airport gate must be able to
    // reach every friend and every bench, and a re-authentication prompt on a bad connection
    // is the thing that stops the work.
    {"action": "accept", "src": ["group:owners"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]},
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:bench"], "users": ["autogroup:nonroot", "root"]},
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:bud"], "users": ["autogroup:nonroot", "root"]},
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:coordination"], "users": ["autogroup:nonroot", "root"]},
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:runner"], "users": ["autogroup:nonroot", "root"]},
    {"action": "accept", "src": ["group:owners"], "dst": ["tag:services"], "users": ["autogroup:nonroot", "root"]},
    // A bud gets a CHECK: a browser re-authentication every twelve hours. A laptop leaves
    // the house, and the machine it can reach from a cafe is the one that runs the work.
    {"action": "check", "src": ["tag:bud"], "dst": ["tag:bench"], "users": ["autogroup:nonroot"], "checkPeriod": "12h"},
  ],

  // Tailscale's OWN tests. `tailscale acl test` runs these, in CI, before a change to this
  // file can be applied -- so the invariants are checked by the thing that enforces them
  // and not by a description of it. Every one of them is a rule of docs/SPEC-FLEET-NET.md.
  "tests": [
    // R5: a bud reaches benches and nothing else.
    {"src": "tag:bud",
     "accept": ["tag:bench:22"],
     "deny": ["tag:bud:22", "tag:coordination:22", "tag:runner:22", "tag:services:22"]},
    // R11 and R3: a bench reaches the stack on its named ports and another bench over ssh -- never the services host's ssh, never the coordination machine, never a runner.
    {"src": "tag:bench",
     "accept": ["tag:services:3100", "tag:bench:22"],
     "deny": ["tag:bud:22", "tag:coordination:22", "tag:runner:22", "tag:services:22"]},
    // R16: the node's own people reach EVERY machine they own on ssh, a runner host and the coordination machine included -- Glenn travelling: `all fleet machines from the air with no restrictions`.
    {"src": "group:owners",
     "accept": ["tag:bench:22", "tag:bud:22", "tag:coordination:22", "tag:runner:22", "tag:services:22"]},
    // R3: a runner host is reachable from nothing TAGGED -- no bench, no bud, no seat's machine. It is the lock of 2026-09-18, asserted rather than assumed, and since Johnny's read of the same day it is true without a note: a shared bench-and-runner host advertises tag:bench only, so there is no overlapping accept to defeat this denial.
    {"src": "tag:bench",
     "deny": ["tag:runner:22", "tag:runner:80", "tag:runner:443"]},
  ],
}
