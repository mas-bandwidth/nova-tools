<?xml version="1.0" encoding="UTF-8"?>
<!-- managed by Ansible (fleet/secrets-refresh.yml) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>{{ sr_label }}</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ sr_script }}</string>
		<string>{{ nova_secrets_store }}</string>
		<string>{{ nova_secrets_refresh_log }}</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key><string>{{ nova_home }}</string>
		<key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>
	<key>StartInterval</key><integer>{{ nova_secrets_refresh_every }}</integer>
	<key>RunAtLoad</key><true/>
	<key>ProcessType</key><string>Background</string>
</dict>
</plist>
