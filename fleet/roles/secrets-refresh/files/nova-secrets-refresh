#!/bin/sh
# nova-secrets-refresh <store dir> <log file>  (fleet/secrets-refresh.yml runs it on a timer)
# Pulls the machine's clone of the secrets store, fast-forward only, so a seat never reads a stale store. A current
# store is a no-op. It never reads or prints the store's contents or any credential, passes no secret on argv, and
# discards git's own output. The log gets one line per run: UTC time, the store's commit id, ok or FAIL rc=<n>.
set -u
store=${1:?usage: nova-secrets-refresh <store dir> <log file>}
log=${2:?usage: nova-secrets-refresh <store dir> <log file>}
mkdir -p "$(dirname "$log")"
if [ ! -d "$store/.git" ]; then
	echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) SKIP no store clone" >> "$log"
	exit 0
fi
# one run at a time (a timer's first run and a run by hand can race into git's index.lock): a mkdir lock beside the
# log; a lock older than 10 minutes is a dead run's and is taken over
lock="$log.lock"
if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null; fi
if ! mkdir "$lock" 2>/dev/null; then
	echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) SKIP another run holds the lock" >> "$log"
	exit 0
fi
trap 'rmdir "$lock" 2>/dev/null' EXIT INT TERM
# macOS has no timeout(1): there the pull is bounded by ssh's ConnectTimeout only
tmo=""; command -v timeout >/dev/null 2>&1 && tmo="timeout 120"
# shellcheck disable=SC2086
GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=20" \
	$tmo git -C "$store" pull -q --ff-only </dev/null >/dev/null 2>&1
rc=$?
head=$(git -C "$store" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
if [ "$rc" -eq 0 ]; then st=ok; else st="FAIL rc=$rc"; fi
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) head=$head $st" >> "$log"
# keep the log small: the last 500 lines
if [ "$(wc -l < "$log")" -gt 1000 ]; then tail -n 500 "$log" > "$log.tmp" && mv "$log.tmp" "$log"; fi
[ "$rc" -eq 0 ]
