{
  "_meta": {
    "hostvars": {
      "bench-a": {
        "ansible_host": "bench-a",
        "ansible_user": "nova",
        "bench_os": "darwin",
        "cores": 2,
        "kind": "machine",
        "nova_arch": "arm64",
        "nova_loops": [
          {
            "name": "tick-bench-a",
            "argv": [
              "~/bin/tick",
              "--once"
            ],
            "seat": "",
            "keys": [],
            "every": 30,
            "keepalive": false,
            "enabled": false,
            "log": "~/nova-bench/loops/tick-bench-a.log"
          }
        ],
        "nova_os": "darwin",
        "nova_pg_dsn": "postgres://nova_config@localhost:5432/nova",
        "nova_redis_addr": "bench-b:6380",
        "nova_redis_port": 6380,
        "nova_seat": "bench-a",
        "nova_tla": false,
        "registry_roles": "bench,coordination",
        "registry_seat": "bench-a",
        "runners": 0,
        "slots": 2,
        "slots_capacity": 2,
        "slots_share": 1,
        "nova_bus_addr": "127.0.0.1:6381"
      },
      "bench-b": {
        "ansible_host": "bench-b",
        "ansible_user": "nova",
        "bench_os": "linux",
        "cores": 4,
        "kind": "machine",
        "nova_arch": "amd64",
        "nova_loops": [
          {
            "name": "member-bench-b",
            "argv": [
              "/usr/bin/env",
              "NOVA_SPRINT_REDIS_USER=bench",
              "NOVA_SPRINT_REDIS_PASSWORD_ENV=NOVA_REDIS_BENCH_PASSWORD",
              "~/.local/bin/nova-swarm",
              "member",
              "--as",
              "bench-b"
            ],
            "seat": "bench-b",
            "keys": [
              "API_KEY",
              "NOVA_REDIS_BENCH_PASSWORD"
            ],
            "every": 0,
            "keepalive": true,
            "enabled": true,
            "log": "~/nova-bench/loops/member-bench-b.log"
          }
        ],
        "nova_os": "linux",
        "nova_pg_dsn": "postgres://nova_config@localhost:5432/nova",
        "nova_redis_addr": "bench-b:6380",
        "nova_redis_port": 6380,
        "nova_seat": "bench-b",
        "nova_tla": true,
        "registry_roles": "bench,runner,services",
        "registry_seat": "bench-b",
        "runners": 1,
        "slots": 4,
        "slots_capacity": 4,
        "slots_share": 2,
        "nova_bus_addr": "127.0.0.1:6381"
      }
    }
  },
  "all": {
    "hosts": [
      "bench-a",
      "bench-b"
    ],
    "vars": {
      "nova_config_rev": {
        "fleet": 1,
        "loop": 1,
        "machine": 1
      },
      "nova_store": "bench-b"
    }
  },
  "adopt": {
    "hosts": [
      "bench-b",
      "bench-a"
    ]
  },
  "benches": {
    "hosts": [
      "bench-a",
      "bench-b"
    ]
  },
  "coordinator": {
    "hosts": [
      "bench-a"
    ]
  },
  "store": {
    "hosts": [
      "bench-b"
    ]
  },
  "store_deployer": {
    "hosts": [
      "bench-a"
    ]
  },
  "runners": {
    "hosts": [
      "bench-b"
    ]
  },
  "tla": {
    "hosts": [
      "bench-b"
    ]
  }
}
