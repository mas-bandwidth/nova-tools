{
  "_meta": {
    "hostvars": {
      "localhost": {
        "ansible_connection": "local",
        "ansible_host": "localhost",
        "ansible_user": "nova",
        "bench_os": "linux",
        "cores": 2,
        "kind": "machine",
        "nova_arch": "amd64",
        "nova_loops": [
          {
            "name": "member-local",
            "argv": [
              "/usr/bin/env",
              "NOVA_SPRINT_REDIS_USER=bench",
              "NOVA_SPRINT_REDIS_PASSWORD_ENV=NOVA_REDIS_BENCH_PASSWORD",
              "nova-swarm",
              "member",
              "--as",
              "localhost",
              "--root",
              "~/nova-bench/run/member-local"
            ],
            "seat": "seat-local",
            "keys": [
              "API_KEY",
              "NOVA_REDIS_BENCH_PASSWORD"
            ],
            "every": 0,
            "keepalive": true,
            "enabled": true,
            "log": "~/nova-bench/loops/member-local.log"
          },
          {
            "name": "tick-local",
            "argv": [
              "~/bin/tick",
              "--once",
              "50%"
            ],
            "seat": "",
            "keys": [],
            "every": 30,
            "keepalive": false,
            "enabled": false,
            "log": "~/nova-bench/loops/tick-local.log"
          }
        ],
        "nova_os": "linux",
        "nova_pg_dsn": "postgres://nova_config@localhost:5432/nova",
        "nova_redis_addr": "localhost:6380",
        "nova_redis_port": 6380,
        "nova_seat": "seat-local",
        "nova_tla": false,
        "registry_roles": "bench,services",
        "registry_seat": "seat-local",
        "runners": 0,
        "slots": 2,
        "slots_capacity": 2,
        "slots_share": 1
      }
    }
  },
  "all": {
    "hosts": [
      "localhost"
    ],
    "vars": {
      "nova_config_rev": {
        "fleet": 1,
        "loop": 1,
        "machine": 1
      },
      "nova_store": "localhost"
    }
  },
  "adopt": {
    "hosts": [
      "localhost"
    ]
  },
  "benches": {
    "hosts": [
      "localhost"
    ]
  },
  "coordinator": {
    "hosts": []
  },
  "store": {
    "hosts": [
      "localhost"
    ]
  },
  "store_deployer": {
    "hosts": []
  },
  "runners": {
    "hosts": []
  },
  "tla": {
    "hosts": []
  }
}
