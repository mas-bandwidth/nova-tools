# {{ nova_sdk_dir }}/env.sh -- THE fleet bench toolchain environment. Written by fleet-toolchains 2026-09-20.
# {{ nova_sdk_dir }} is the ONE home root internal/swarm/toolchain.go grants EXECUTE inside the card
# sandbox on linux, so every toolchain the bench standard owns resolves from here and nowhere
# else. Sourced from the FIRST line of ~/.bashrc on Linux and from ~/.zshenv on macOS: those
# are what a NON-LOGIN shell reads, and cards and make recipes never get a login shell.
case ":$PATH:" in
  *":{{ nova_sdk_dir }}/bin:"*) ;;
  *) PATH="{{ nova_sdk_dir }}/bin:{{ nova_home }}/go/bin:{{ nova_home }}/.local/bin:$PATH" ;;
esac
export PATH

# .NET. The read-only CLI home seeded under {{ nova_sdk_dir }} skips the first-run configurer, whose
# NuGet MigrationRunner takes a named mutex; the package dir follows the JOB's HOME, which is
# inside a --write. See fleet-toolchains/seed-dotnet.sh for the measurement.
export DOTNET_CLI_HOME="{{ nova_sdk_dir }}/dotnet-home"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export NUGET_PACKAGES="$HOME/.nuget/packages"

# Erlang/Elixir keep their per-user state beside the job, not beside the bench.
export MIX_HOME="$HOME/.mix"
export HEX_HOME="$HOME/.hex"
