{# fleet/services.yml renders this for one service record l that runs every n
   seconds on a linux machine: it starts nova-service-<name>.service, a oneshot,
   n seconds after the run before it began, and once soon after boot. #}
# {{ service_dir }}/nova-service-{{ l.name }}.timer: written by fleet/services.yml from the service record {{ l.name }}
[Unit]
Description=nova service {{ l.name }}, every {{ l.every }} s

[Timer]
OnBootSec=10
OnUnitActiveSec={{ l.every }}
AccuracySec=1s
Unit=nova-service-{{ l.name }}.service

[Install]
WantedBy=timers.target
