{# fleet/loops.yml renders this for one loop record l on a linux machine:
   every value is the record's (l) or the host layout's (group_vars/all.yml).
   A word of ExecStart is double-quoted, with systemd's specifiers (%) and
   variables ($) doubled so the record's text reaches the program as written. #}
# {{ loop_dir }}/nova-loop-{{ l.name }}.service: written by fleet/loops.yml from the loop record {{ l.name }}
[Unit]
Description=nova loop {{ l.name }}
After=network-online.target
# A loop restarts however often it ends; the record decides how soon.
StartLimitIntervalSec=0

[Service]
Type=simple
{% if loop_become %}
User={{ ansible_user_id }}
{% endif %}
WorkingDirectory={{ nova_home }}
Environment="HOME={{ nova_home }}"
Environment="PATH={{ nova_loop_path }}"
ExecStart={% for w in loop_exec %}"{{ w | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"{{ ' ' if not loop.last else '' }}{% endfor %}

{% if l.keepalive %}
Restart=always
RestartSec=10
{% else %}
# A periodic loop runs once and exits; systemd starts it again {{ l.every }} s later.
Restart=always
RestartSec={{ l.every }}
{% endif %}
StandardOutput=append:{{ loop_log }}
StandardError=append:{{ loop_log }}

[Install]
WantedBy={{ 'multi-user.target' if loop_become else 'default.target' }}
