// tailscale-acl.json: a starter tailnet policy for a nova fleet (docs/FLEET.md, "tailscale.yml").
// Paste it into the admin console (Access controls), then edit the owner: replace owner@example.com with the
// account that owns the tailnet. It is the whole policy: anything not allowed here is denied, and a tailnet
// member's own devices reach no fleet machine.
//
//   tag:nova      every machine fleet/tailscale.yml joins
//   tag:runner    a machine with the runner role, which carries tag:nova too
//   tag:control   the control node: the one machine that runs the plays and nova-config
//
// tag:nova and tag:runner machines reach each other on 22 (Tailscale SSH), 6379 (the bus's Redis, redis.yml) and
// 5432 (nova-config's PostgreSQL, postgres.yml), and nothing else. The control node reaches them on the same three
// ports, and logs in over Tailscale SSH as the non-root logins (the plays use sudo from there).
{
	"tagOwners": {
		"tag:nova":    ["owner@example.com"],
		"tag:runner":  ["owner@example.com"],
		"tag:control": ["owner@example.com"],
	},

	"grants": [
		// the fleet, among itself: ssh, the bus, the config store
		{
			"src": ["tag:nova", "tag:runner"],
			"dst": ["tag:nova", "tag:runner"],
			"ip":  ["tcp:22", "tcp:6379", "tcp:5432"],
		},
		// the control node: ssh for the plays, the bus, the config store
		{
			"src": ["tag:control"],
			"dst": ["tag:nova", "tag:runner"],
			"ip":  ["tcp:22", "tcp:6379", "tcp:5432"],
		},
	],

	// Tailscale SSH: which tagged machines may log in as which users. Never root, and no member's device.
	"ssh": [
		{
			"action": "accept",
			"src":    ["tag:nova", "tag:runner", "tag:control"],
			"dst":    ["tag:nova", "tag:runner"],
			"users":  ["autogroup:nonroot"],
		},
	],
}
