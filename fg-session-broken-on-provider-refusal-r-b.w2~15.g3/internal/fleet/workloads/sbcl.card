roles: bench
expect: ^SBCL OK
wall: yes
reads: $HOME/sdk, $HOME/.local, /usr, /bin, /lib, /lib64, /etc, /opt/homebrew

# The lisp leg runs from inside the wall like every other card, and sbcl on a bench lives
# under ~/sdk rather than on the system PATH. Both halves are checked here.
set -eu
SBCL=$(command -v sbcl 2>/dev/null || true)
if [ -z "$SBCL" ]; then
  for candidate in "$NOVA_HOME"/sdk/sbcl*/run-sbcl.sh "$NOVA_HOME"/sdk/bin/sbcl "$NOVA_HOME"/.local/bin/sbcl; do
    if [ -x "$candidate" ]; then SBCL="$candidate"; break; fi
  done
fi
if [ -z "$SBCL" ]; then
  echo "SBCL FAIL no sbcl is reachable inside the wall (name the SDK root in the workload's reads)"
  exit 1
fi
VERSION=$("$SBCL" --version 2>&1 | head -n 1)
if ! "$SBCL" --non-interactive --no-userinit --eval '(progn (format t "~a~%" (* 6 7)) (sb-ext:quit))' > run.out 2>&1; then
  echo "SBCL FAIL $VERSION could not evaluate"
  head -n 3 run.out
  exit 1
fi
if ! grep -q '^42$' run.out; then
  echo "SBCL FAIL $VERSION did not answer 42"
  exit 1
fi
echo "SBCL OK $VERSION"
