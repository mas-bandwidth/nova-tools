# redis-server 8.10.2 on Studio, 2026-09-26: a throwaway server (--save "", loopback, a temp dir) started with --aclfile of
# testdata/acl-rows.tsv written the play's way (user <name> on #<sha256 of the test password x> <rules>, default off),
# then INFO server, ACL LIST, and ACL CAT <category> for every category, read as admin.
== version
redis_version:8.10.2
