# redis-server 7.0.15 on hetzner, 2026-09-26: a throwaway server (--save "", loopback, a temp dir) started with --aclfile of
# testdata/acl-rows.tsv written the play's way (user <name> on #<sha256 of the test password x> <rules>, default off),
# then INFO server, ACL LIST, and ACL CAT <category> for every category, read as admin.
== version
redis_version:7.0.15
== list
user admin on #2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881 ~* &* +@all
