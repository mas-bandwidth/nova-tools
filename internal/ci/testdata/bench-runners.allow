# derived at nova-tools dev ce8631be6 (base-sha of the #2932 Part A build) by TestCIOneBenchRunner's rule
# bench-runners.allow (#2932): every ssh exec site outside pkg/bench, one row per site keyed
# `<file> <func>` (lines move; the key does not), then TAB shape TAB retiring issue. Shrink only:
# a new site uses pkg/bench (`nova-ci bench run`, a Go verb, no script), and a retired site deletes its row.
pkg/release/edges.go ExecSSH.Fetch	raw argv	#3350
pkg/release/edges.go ExecSSH.Run	raw argv (exec in runCommandCapped)	#3350
pkg/release/edges.go ExecSSH.Send	raw: `mkdir -p <dest> && tar -C <dest> -xf -`; tar on stdin	#3350
pkg/secrets/place.go sshPlaceSecret	raw: `umask 077 && ... cat > <path>` (nova-secrets --ssh); value on stdin	#3350
