roles: coordination
expect: ^BUS OK

# A coordination host's one representative piece of work is talking on the bus, and the
# thing that stops it is a bus repository with a dirty tree or a branch behind its remote.
set -eu
# The bus is where NOVA_BUS says, or one of the conventional places. It looked in exactly
# ONE place until the first real fleet-wide run, and the Studio -- which talks on the bus all
# day -- was told it had no bus at all, because its clone is not called ~/nova-bus. A check
# that names one guess and calls a machine broken is a check that teaches people to ignore it.
BUS=""
for candidate in "${NOVA_BUS:-}" "$NOVA_HOME/nova-bus" "$NOVA_HOME/bus"; do
  if [ -n "$candidate" ] && [ -d "$candidate/.git" ]; then
    BUS="$candidate"
    break
  fi
done
if [ -z "$BUS" ]; then
  echo "BUS FAIL no bus repository in \$NOVA_BUS, $NOVA_HOME/nova-bus or $NOVA_HOME/bus; set NOVA_BUS to the clone this host sends from"
  exit 1
fi
GIT=$(command -v git 2>/dev/null || true)
if [ -z "$GIT" ]; then
  echo "BUS FAIL no git on the coordination host"
  exit 1
fi
DIRTY=$("$GIT" -C "$BUS" status --porcelain 2>&1 | head -n 3)
if [ -n "$DIRTY" ]; then
  echo "BUS FAIL $BUS has uncommitted changes: $DIRTY"
  exit 1
fi
BRANCH=$("$GIT" -C "$BUS" rev-parse --abbrev-ref HEAD 2>&1)
LOCAL=$("$GIT" -C "$BUS" rev-parse HEAD 2>&1)
REMOTE=$("$GIT" -C "$BUS" rev-parse "@{upstream}" 2>/dev/null || echo "-")
if [ "$REMOTE" = "-" ]; then
  echo "BUS FAIL $BUS branch $BRANCH tracks no upstream"
  exit 1
fi
if [ "$LOCAL" != "$REMOTE" ]; then
  echo "BUS FAIL $BUS branch $BRANCH is not in sync: local $LOCAL upstream $REMOTE"
  exit 1
fi
echo "BUS OK $BUS branch=$BRANCH head=$LOCAL"
