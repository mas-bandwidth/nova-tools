roles: runner
expect: ^DIAG OK
report: yes

# REPORT ONLY, deliberately: 15.7 GB of runner _diag logs across the fleet on 2026-09-18 had
# broken nothing, and a check that fails a machine for it is a check people learn to pass
# over. It is measured, written and printed as a WARN, and it never withholds a certificate.
#
# THE RATE IS THE NUMBER THAT MATTERS. hulk held 3576 MB in 18167 logs with nothing older
# than two days -- about 1.8 GB a day -- so a seven-day retention rule cannot bound it and a
# size read alone cannot say so. The line carries MB, the age of the oldest log, and the
# rate, so the hygiene that follows is argued from a rate and not from a snapshot.
#
# THE OLDEST-LOG READ CHOOSES ITS SPELLING AT RUNTIME. It was `find -printf '%T@'`, which is
# GNU: BSD find has none, so on the M2 Air the read came back EMPTY, the age fell back to one
# day, and the card reported the SIZE as the rate and said OK. A silent wrong number is worse
# than a failure, so the age is `unknown` when nothing could be read and the line says so.
set -eu
if [ "$(uname -s)" = Darwin ]; then MTIME="stat -f %m"; else MTIME="stat -c %Y"; fi
TOTAL=0
DIRS=0
OLDEST=""
for d in "$NOVA_HOME"/runner-nova-tools-*/_diag "$NOVA_HOME"/actions-runner-*/_diag; do
  [ -d "$d" ] || continue
  DIRS=$((DIRS + 1))
  mb=$(du -sm "$d" 2>/dev/null | awk '{print $1}')
  [ -n "$mb" ] && TOTAL=$((TOTAL + mb))
  o=$(find "$d" -type f -name '*.log' -exec $MTIME {} + 2>/dev/null | sort -n | head -n 1)
  if [ -n "$o" ]; then
    if [ -z "$OLDEST" ] || [ "${o%%.*}" -lt "${OLDEST%%.*}" ]; then OLDEST="$o"; fi
  fi
done
if [ "$DIRS" = "0" ]; then
  echo "DIAG OK no _diag directory on this host"
  exit 0
fi
DAYS=1
RATE="$TOTAL"
AGE_WORD="unknown"
if [ -n "$OLDEST" ]; then
  NOW=$(date +%s)
  AGE=$(( (NOW - ${OLDEST%%.*}) / 86400 ))
  [ "$AGE" -lt 1 ] && AGE=1
  DAYS="$AGE"
  RATE=$((TOTAL / DAYS))
  AGE_WORD="${DAYS}d"
fi
if [ "$TOTAL" -ge 2048 ]; then
  echo "DIAG OVER $TOTAL MB across $DIRS _diag directories, oldest $AGE_WORD, about $RATE MB/day, over the 2048 MB watch line"
  exit 1
fi
echo "DIAG OK $TOTAL MB across $DIRS _diag directories, oldest $AGE_WORD, about $RATE MB/day"
