roles: bench
expect: ^SERVICES OK

# A plain ssh from the BENCH, by the NAME the design uses, because that is what failed.
#
# On 2026-09-18 redis on space bound 127.0.0.1 only, so a PING from hulk was refused; `getent
# hosts space` was empty on hulk and vision (no MagicDNS -- the name works only through
# ~/.ssh/config); and Loki and Grafana answered on the tailnet address and nowhere else. The
# evidence NAMES the address tried, because "connection refused" without one sends a person
# to the wrong machine.
set -eu
HOST="${NOVA_SERVICES_HOST:-space}"
ADDR=$(getent hosts "$HOST" 2>/dev/null | awk 'NR==1{print $1}' || true)
if [ -z "$ADDR" ]; then
  echo "SERVICES FAIL the name '$HOST' does not resolve on this bench (getent hosts '$HOST' is empty; ~/.ssh/config is not name resolution)"
  exit 1
fi
TRIED="name=$HOST addr=$ADDR"
CLI=$(command -v redis-cli 2>/dev/null || true)
if [ -z "$CLI" ]; then
  echo "SERVICES FAIL no redis-cli on this bench ($TRIED)"
  exit 1
fi
PING=$("$CLI" -h "$ADDR" -p "${NOVA_REDIS_PORT:-6379}" ping 2>&1 || true)
case "$PING" in
  *PONG*) ;;
  *) echo "SERVICES FAIL redis $TRIED:${NOVA_REDIS_PORT:-6379} $PING"; exit 1 ;;
esac
CURL=$(command -v curl 2>/dev/null || true)
if [ -z "$CURL" ]; then
  echo "SERVICES FAIL no curl on this bench ($TRIED)"
  exit 1
fi
LOKI=$("$CURL" -fsS --max-time 10 "http://$ADDR:${NOVA_LOKI_PORT:-3100}/ready" 2>&1 || true)
case "$LOKI" in
  *ready*) ;;
  *) echo "SERVICES FAIL loki $TRIED:${NOVA_LOKI_PORT:-3100} $LOKI"; exit 1 ;;
esac
echo "SERVICES OK $TRIED redis=PONG loki=ready"
