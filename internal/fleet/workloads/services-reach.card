roles: bench
expect: ^SERVICES OK
warn: ^SERVICES AUTH-REQUIRED

# A plain ssh from the BENCH, by the NAME the design uses, because that is what failed.
#
# The evidence NAMES the address tried and DISTINGUISHES the three answers, because they
# have three different remedies and "connection refused" for all of them sends a person to
# the wrong machine:
#
#   refused                -- nothing is listening on that address (redis bound 127.0.0.1)
#   denied (protected mode) -- the path and the name work and the password gate remains;
#                              Redis 8 enforces protected mode even with an explicit bind,
#                              so this is the state space is in until requirepass lands
#                              through nova-secrets
#   PONG                   -- and only PONG is OK
#
# The name must RESOLVE, by whatever the machine has: /etc/hosts carries the tailnet
# addresses on the Linux benches, and a LAN address is as good an answer. No tailnet address
# is required -- the Studio has none (tailscaled is not running there) and is not a bench.
set -eu
# THE ADDRESS COMES FROM THE REGISTRY, never from DNS. This resolved the name with the name
# service, which darwin does not answer the way Linux does, so the Air was told that space
# could not be resolved while it was talking to space over ssh at that same moment. The
# registry is the file that already knows where every machine is, and the engine hands it
# down as NOVA_SERVICES_ADDR.
HOST="${NOVA_SERVICES_HOST:-space}"
ADDR="${NOVA_SERVICES_ADDR:-}"
if [ -z "$ADDR" ]; then
  echo "SERVICES FAIL the registry names no machine with the services role, so this bench has no services address to try"
  exit 1
fi
TRIED="name=$HOST addr=$ADDR"
CLI=$(command -v redis-cli 2>/dev/null || true)
if [ -z "$CLI" ]; then
  echo "SERVICES FAIL no redis-cli on this bench ($TRIED)"
  exit 1
fi
PING=$("$CLI" -h "$ADDR" -p "${NOVA_REDIS_PORT:-6379}" ping 2>&1 || true)
case "$PING" in
  *PONG*)
    REDIS="PONG" ;;
  *DENIED*|*"protected mode"*|*NOAUTH*|*WRONGPASS*)
    # NOT A FAILURE OF THIS BENCH. The address and the port are RIGHT -- redis answered --
    # and what is missing is the seat's password, which lands through nova-secrets on
    # somebody else's schedule. In the FAIL branch this card could not pass its own remedy,
    # so it held every bench uncertified for a thing no bench can do.
    echo "SERVICES AUTH-REQUIRED redis $TRIED:${NOVA_REDIS_PORT:-6379} answered but wants the password: set requirepass on the services host and give each bench the key through nova-secrets -- $PING"
    exit 0 ;;
  *refused*|*"Connection refused"*)
    echo "SERVICES FAIL redis $TRIED:${NOVA_REDIS_PORT:-6379} refused: nothing is listening on that address (check the bind line, not the name) -- $PING"
    exit 1 ;;
  *)
    echo "SERVICES FAIL redis $TRIED:${NOVA_REDIS_PORT:-6379} $PING"
    exit 1 ;;
esac
CURL=$(command -v curl 2>/dev/null || true)
if [ -z "$CURL" ]; then
  echo "SERVICES FAIL no curl on this bench ($TRIED)"
  exit 1
fi
LOKI=$("$CURL" -fsS --max-time 10 "http://$ADDR:${NOVA_LOKI_PORT:-3100}/ready" 2>&1 || true)
case "$LOKI" in
  *ready*) ;;
  *) echo "SERVICES FAIL loki $TRIED:${NOVA_LOKI_PORT:-3100} $LOKI"; exit 1 ;;
esac
echo "SERVICES OK $TRIED redis=$REDIS loki=ready"
