roles: bench
expect: ^SBCL OK
wall: yes
reads: $HOME/sdk, $HOME/.local, /usr, /bin, /lib, /lib64, /etc, /opt/homebrew/Cellar/sbcl, /opt/homebrew/lib, /opt/homebrew/share, /opt/homebrew/opt

# The lisp leg runs from inside the wall like every other card. sbcl on a LINUX bench lives
# under ~/sdk rather than on the system PATH; on a DARWIN bench it is brew's, in the Cellar
# tree behind /opt/homebrew/bin/sbcl -- which is a directory of launchers and never a granted
# root. All of them are checked here, the tree before the launcher.
set -eu
SBCL=""
for candidate in /opt/homebrew/Cellar/sbcl/*/bin/sbcl "$NOVA_HOME"/sdk/sbcl*/run-sbcl.sh "$NOVA_HOME"/sdk/bin/sbcl "$NOVA_HOME"/.local/bin/sbcl; do
  if [ -x "$candidate" ]; then SBCL="$candidate"; break; fi
done
if [ -z "$SBCL" ]; then SBCL=$(command -v sbcl 2>/dev/null || true); fi
if [ -z "$SBCL" ]; then
  echo "SBCL FAIL no sbcl is reachable inside the wall (name the SDK root in the workload's reads)"
  exit 1
fi
VERSION=$("$SBCL" --version 2>&1 | head -n 1)
if ! "$SBCL" --non-interactive --no-userinit --eval '(progn (format t "~a~%" (* 6 7)) (sb-ext:quit))' > run.out 2>&1; then
  echo "SBCL FAIL $VERSION could not evaluate"
  head -n 3 run.out
  exit 1
fi
if ! grep -q '^42$' run.out; then
  echo "SBCL FAIL $VERSION did not answer 42"
  exit 1
fi
echo "SBCL OK $VERSION"
