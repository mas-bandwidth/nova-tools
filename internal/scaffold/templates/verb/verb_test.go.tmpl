package main

import (
	"bytes"
	"os"
	"path/filepath"
	"strings"
	"testing"
)

func TestCmd[[ .CamelVerb ]](t *testing.T) {
	t.Parallel()

	var stdout, stderr bytes.Buffer
	code := cmd[[ .CamelVerb ]](nil, &stdout, &stderr)
	if code != 0 {
		t.Fatalf("[[ .Verb ]] returned %d, want 0; stderr:\n%s", code, stderr.String())
	}
	if !strings.Contains(stdout.String(), "[[ .Tool ]] [[ .Verb ]]: OK") {
		t.Fatalf("[[ .Verb ]] output = %q, want OK", stdout.String())
	}
}

func TestCmd[[ .CamelVerb ]]Fixture(t *testing.T) {
	t.Parallel()

	path := filepath.Join("testdata", "[[ .Verb ]]", "fixture.txt")
	data, err := os.ReadFile(path)
	if err != nil {
		t.Fatalf("missing fixture %s: %v", path, err)
	}
	if len(strings.TrimSpace(string(data))) == 0 {
		t.Fatalf("fixture %s is empty", path)
	}
}
