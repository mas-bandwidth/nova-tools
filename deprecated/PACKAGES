# Packages that are deprecated and still in the tree, because living tools
# import them. CI never selects a package named here or under a prefix named
# here (.github/scripts/select-packages.sh). One path per line, from the
# repository root. A line "keep <path>" names one package under a prefix that
# living tools stand on today: it stays tested until it is lifted out into a
# shared module, and then its line goes. This list only shrinks: a package
# leaves it by moving under deprecated/ or by being deleted.

# nova-sprint (Glenn 2026-09-27: deprecated, to be rewritten on nova-table)
cmd/nova-sprint
internal/nsprint
internal/sprinttable
internal/sprintline

# what nova-table, nova-config and others stand on until it is lifted out
keep internal/nsprint/store
keep internal/nsprint/redisauth
keep internal/nsprint/pipeerr
keep internal/nsprint/fn
keep internal/nsprint/testutil
keep internal/nsprint/testutil/pg
keep internal/nsprint/verbflag

# nova-swarm (Glenn 2026-09-27: retired for now; its pool dispatcher is reachable
# from no command and is to be rewritten on nova-table with the sprint).
# cmd/nova-swarm moved to deprecated/cmd/. Living code still stands on
# internal/swarm, so it stays here and stays tested until it is lifted out:
# internal/ci's card-template and toolchain-root class tests, and internal/redisq's
# and internal/secrets' tests.
internal/swarm
keep internal/swarm

# nova-decide (Glenn 2026-09-27: parked because it is not proven yet; the Jev
# client, to return when its value is measured). cmd/nova-decide,
# internal/jevcalib and internal/decide/redtriage moved to deprecated/. Living
# tools stand on the rest, so it stays tested until it is lifted out.
internal/decide
# cmd/nova-merge, cmd/nova-review, internal/prereview and internal/swarm (kept)
keep internal/decide
# internal/decide
keep internal/decide/questions

# Jev's gate line: imported only by cmd/nova-sprint and
# internal/nsprint/land/stream, both deprecated and still in the root module;
# it moves under deprecated/internal/ when they do.
internal/jev
