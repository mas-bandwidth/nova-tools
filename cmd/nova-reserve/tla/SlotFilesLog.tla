------------------------------ MODULE SlotFilesLog ------------------------------
(* The walks of cmd/nova-reserve/trace_test.go (TestTracesAreBehavioursOfTheModels), as SlotFiles.tla's     *)
(* state after each action: the action and its process, then pc, scan, mine, slotEx, gateEx, gateSh, allEx,    *)
(* allSh, rounds, crashes and cmd, read off the lock table and the takers. Written by that test               *)
(* (RESERVE_UPDATE_LOG=1); SlotFilesTrace.tla checks each walk is a behaviour of SlotFiles.tla. BrokenNoLock is  *)
(* the same code over a lock table that grants a held slot, which it must refuse.                            *)
S(a, p, pc, scan, mine, slotEx, gateEx, gateSh, allEx, allSh, rounds, crashes, cmd) ==
    [a |-> a, p |-> p, pc |-> pc, scan |-> scan, mine |-> mine, slotEx |-> slotEx, gateEx |-> gateEx,
     gateSh |-> gateSh, allEx |-> allEx, allSh |-> allSh, rounds |-> rounds, crashes |-> crashes, cmd |-> cmd]
BrokenNoLock == <<
    <<
        S("Init", "none", [p1 |-> "idle", p2 |-> "idle", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 0, p2 |-> 0, p3 |-> 0], <<"none", "none">>, "none", {}, "none", {}, [p1 |-> 0, p2 |-> 0, p3 |-> 0], 0, {}),
        S("Start", "p1", [p1 |-> "sgate", p2 |-> "idle", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 0, p2 |-> 0, p3 |-> 0], <<"none", "none">>, "none", {}, "none", {}, [p1 |-> 1, p2 |-> 0, p3 |-> 0], 0, {}),
        S("SGate", "p1", [p1 |-> "sscan", p2 |-> "idle", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 0, p2 |-> 0, p3 |-> 0], <<"none", "none">>, "none", {"p1"}, "none", {}, [p1 |-> 1, p2 |-> 0, p3 |-> 0], 0, {}),
        S("SScan", "p1", [p1 |-> "sall", p2 |-> "idle", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 0, p3 |-> 0], <<"p1", "none">>, "none", {"p1"}, "none", {}, [p1 |-> 1, p2 |-> 0, p3 |-> 0], 0, {}),
        S("SAll", "p1", [p1 |-> "srun", p2 |-> "idle", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 0, p3 |-> 0], <<"p1", "none">>, "none", {}, "none", {"p1"}, [p1 |-> 1, p2 |-> 0, p3 |-> 0], 0, {"p1"}),
        S("Start", "p2", [p1 |-> "srun", p2 |-> "sgate", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 0, p3 |-> 0], <<"p1", "none">>, "none", {}, "none", {"p1"}, [p1 |-> 1, p2 |-> 1, p3 |-> 0], 0, {"p1"}),
        S("SGate", "p2", [p1 |-> "srun", p2 |-> "sscan", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 0, p3 |-> 0], <<"p1", "none">>, "none", {"p2"}, "none", {"p1"}, [p1 |-> 1, p2 |-> 1, p3 |-> 0], 0, {"p1"}),
        S("SScan", "p2", [p1 |-> "srun", p2 |-> "sall", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 1, p3 |-> 0], <<"p1", "none">>, "none", {"p2"}, "none", {"p1"}, [p1 |-> 1, p2 |-> 1, p3 |-> 0], 0, {"p1"}),
        S("SAll", "p2", [p1 |-> "srun", p2 |-> "srun", p3 |-> "idle"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 1, p3 |-> 0], <<"p1", "none">>, "none", {}, "none", {"p1", "p2"}, [p1 |-> 1, p2 |-> 1, p3 |-> 0], 0, {"p1", "p2"}),
        S("Start", "p3", [p1 |-> "srun", p2 |-> "srun", p3 |-> "sgate"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 1, p3 |-> 0], <<"p1", "none">>, "none", {}, "none", {"p1", "p2"}, [p1 |-> 1, p2 |-> 1, p3 |-> 1], 0, {"p1", "p2"}),
        S("SGate", "p3", [p1 |-> "srun", p2 |-> "srun", p3 |-> "sscan"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 1, p3 |-> 0], <<"p1", "none">>, "none", {"p3"}, "none", {"p1", "p2"}, [p1 |-> 1, p2 |-> 1, p3 |-> 1], 0, {"p1", "p2"}),
        S("SScan", "p3", [p1 |-> "srun", p2 |-> "srun", p3 |-> "sall"], [p1 |-> 1, p2 |-> 1, p3 |-> 1], [p1 |-> 1, p2 |-> 1, p3 |-> 1], <<"p1", "none">>, "none", {"p3"}, "none", {"p1", "p2"}, [p1 |-> 1, p2 |-> 1, p3 |-> 1], 0, {"p1", "p2"}),
