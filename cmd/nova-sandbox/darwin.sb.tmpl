;; nova-sandbox: the darwin sandbox-exec profile, as a template (profile.go fills it).
;;
;; The filled text goes to sandbox-exec inline with -p, so no profile file exists to be
;; replaced or left behind. Caller paths arrive as -D NAME=<path> and are read back as
;; (param "NAME"); a param the text names and the caller does not pass fails to compile
;; (exit 65) rather than weakening the wall. The ancestor and link literals are the only
;; paths written into the text, which is why a path with a quote, backslash or paren is
;; refused.
;;
;; A line holding only a marker is replaced:
;;   @@OPTROOTS@@   read on the active developer directory, when it is outside the roots
;;   @@ANCESTORS@@  stat only (file-read-metadata) on every proper ancestor of every
;;                  granted path: without it mkdir and stat by absolute path die at
;;                  /private or /Users. Listing stays denied.
;;   @@READS@@      read on each --read, and on the caller's symlink spellings
;;   @@WRITES@@     read+write on each --write, and network-outbound there: the only
;;                  unix-socket reach is a socket inside a --write
;;   @@NET@@        IP-only outbound plus the DNS socket; under --net-deny only the
;;                  --net-allow ports. Never (allow network*), which would grant every
;;                  unix socket on the machine.

(version 1)
;; The default deny does not report: with a reporting deny a large walled binary was
;; measured to hang on cold starts, its denied thread waiting on a violation report.
;; The deny itself is the same.
(deny default (with no-report))

;; exec and signal are two clauses: folding them into one applies the target filter
;; to the exec too and denies it (execvp: Operation not permitted, exit 71).
(allow process-exec* process-fork)
(allow signal (target self) (target children))

(allow sysctl-read)

;; mach-lookup is narrowed to the services ordinary commands need, measured by growing
;; the set until a shell, git, curl to an https name, node and `go mod download` ran:
;;   opendirectoryd.libinfo  getpwuid(3) and getaddrinfo(3)
;;   SecurityServer          TLS trust evaluation (curl)
;;   system.logger           os_log(3), which libsystem calls on many paths
;;   trustd.agent            SecTrustEvaluateWithError, which Go's crypto/x509 calls
;; An unqualified (allow mach-lookup) was measured to let pbpaste read the clipboard;
;; under this set it fails. `launchctl print system` and `security list-keychains`
;; (file names only, no secret) still answer under it.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.trustd.agent"))

;; The symlinks macOS keeps in / are granted as literals on the link, not subpaths on
;; their targets. Without them `cat /etc/hosts` is denied and /bin/sh dies opening
;; /private/var/select/sh. The xcode-select link is how the /usr/bin compiler and git
;; shims find the developer directory.
(allow file-read* (literal "/") (literal "/etc") (literal "/tmp") (literal "/var"))
(allow file-read* (literal "/var/db/xcode_select_link") (literal "/private/var/db/xcode_select_link"))

(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/opt/homebrew"))
(allow file-read* (subpath "/opt/local"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/private/var/select"))
;; the zoneinfo database: without it every program runs in UTC.
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath "/dev"))
@@OPTROOTS@@

@@ANCESTORS@@

@@READS@@

@@WRITES@@

(allow file-write* (literal "/dev/null") (literal "/dev/tty"))

@@NET@@
