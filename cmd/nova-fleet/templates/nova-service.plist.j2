<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
{# cmd/nova-fleet/services.yml renders this for one service record l on a darwin machine:
   every value is the record's (l) or the host layout's (group_vars/all.yml);
   the unit's environment is service_env (HOME, PATH and the record's env) and its
   log is service_log. #}
<!-- {{ service_dir }}/com.nova.service.{{ l.name }}.plist: written by fleet/services.yml from the service record {{ l.name }} -->
<plist version="1.0">
<dict>
{% if not l.enabled %}
<key>Disabled</key>
<true/>
{% endif %}
<key>Label</key>
<string>com.nova.service.{{ l.name | e }}</string>
{% if service_system %}
<key>UserName</key>
<string>{{ ansible_facts['user_id'] | e }}</string>
{% endif %}
<key>ProgramArguments</key>
<array>
{% for w in service_exec %}
<string>{{ w | e }}</string>
{% endfor %}
</array>
<key>EnvironmentVariables</key>
<dict>
{% for k, v in service_env | dictsort %}
<key>{{ k | e }}</key>
<string>{{ v | string | e }}</string>
{% endfor %}
</dict>
<key>WorkingDirectory</key>
<string>{{ nova_home | e }}</string>
<key>RunAtLoad</key>
<true/>
{% if l.keepalive %}
<key>KeepAlive</key>
<true/>
<key>ThrottleInterval</key>
<integer>10</integer>
{% else %}
<key>StartInterval</key>
<integer>{{ l.every }}</integer>
{% endif %}
<key>AbandonProcessGroup</key>
<true/>
<key>StandardOutPath</key>
<string>{{ service_log | e }}</string>
<key>StandardErrorPath</key>
<string>{{ service_log | e }}</string>
</dict>
</plist>
