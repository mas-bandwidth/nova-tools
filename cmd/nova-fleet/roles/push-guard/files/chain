#!/bin/sh
# nova-fleet push-guard (nova-tools cmd/nova-fleet push-guard.yml): core.hooksPath names this directory, which hides
# .git/hooks, so this runs the repository's own hook of this file's name, when it has one. A repository still being
# made (git init's reference-transaction) has no hooks of its own yet: nothing runs and nothing is printed.
common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
own="$common/hooks/${0##*/}"
[ -x "$own" ] || exit 0
exec "$own" "$@"
