# {{ nova_sdk_dir }}/env.sh -- the SDK toolchain environment, written by the sdk-toolchain role (nova-fleet sdk-toolchain).
# For the shells a person or a make recipe gets: on Linux ~/.bashrc sources it on its first line. A job runner or
# sandbox that sets its own PATH puts {{ nova_sdk_dir }}/bin first itself.
#
# The SDK's directories are taken out of PATH wherever they are and put back first, so the order is right however
# many times this is sourced and whatever ran before it. Parameter expansion only: the same in sh, bash and zsh (zsh
# does not split $PATH on IFS), and no fork.
_sdk_rest="$PATH:"; _sdk_path=""
while [ -n "$_sdk_rest" ]; do
  _sdk_dir=${_sdk_rest%%:*}; _sdk_rest=${_sdk_rest#*:}
  case "$_sdk_dir" in
    ""|"{{ nova_sdk_dir }}/bin"|"{{ ansible_facts['user_dir'] }}/go/bin"|"{{ ansible_facts['user_dir'] }}/.local/bin") ;;
    *) _sdk_path="${_sdk_path:+$_sdk_path:}$_sdk_dir" ;;
  esac
done
PATH="{{ nova_sdk_dir }}/bin:{{ ansible_facts['user_dir'] }}/go/bin:{{ ansible_facts['user_dir'] }}/.local/bin${_sdk_path:+:$_sdk_path}"
export PATH
unset _sdk_rest _sdk_path _sdk_dir

# .NET. The CLI home under the SDK holds the first-run state, so a job does not run the first-run configurer (whose
# NuGet migration takes a named mutex); the packages and NuGet's caches follow the job's HOME. A job that wants its own
# CLI home sets DOTNET_CLI_HOME itself.
export DOTNET_CLI_HOME="{{ nova_sdk_dir }}/dotnet-home"
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
export NUGET_PACKAGES="$HOME/.nuget/packages"
export NUGET_HTTP_CACHE_PATH="$HOME/.local/share/NuGet/http-cache"
export NUGET_PLUGINS_CACHE_PATH="$HOME/.local/share/NuGet/plugin-cache"
#
# No dotnet build server outlives the build: each inherits the build's open file descriptors and stays up after `make`
# returns, holding whatever lock the build held.
#   the MSBuild server: on by default for the CLI, off with DOTNET_CLI_DO_NOT_USE_MSBUILD_SERVER=1
#     (github.com/dotnet/msbuild documentation/MSBuild-Server.md); DOTNET_CLI_USE_MSBUILD_SERVER=0 is the older switch;
#   MSBuild's worker nodes remain after the build by default; MSBUILDDISABLENODEREUSE=1 leaves none behind
#     (github.com/dotnet/msbuild documentation/wiki/MSBuild-Environment-Variables.md);
#   the C#/VB compiler server (VBCSCompiler): UseSharedCompilation=false, as an environment variable, is the MSBuild
#     property the SDK's targets read, unless a project sets it itself.
export DOTNET_CLI_DO_NOT_USE_MSBUILD_SERVER=1
export DOTNET_CLI_USE_MSBUILD_SERVER=0
export MSBUILDDISABLENODEREUSE=1
export UseSharedCompilation=false

# Erlang/Elixir keep their per-user state beside the job, not beside the SDK.
export MIX_HOME="$HOME/.mix"
export HEX_HOME="$HOME/.hex"
{% if nova_sdk_env %}

# Make variables (nova_sdk_env) some repositories' Makefiles read with `?=`, so a make run here takes the toolchain on PATH.
{% for k, v in nova_sdk_env.items() %}
export {{ k }}={{ v | quote }}
{% endfor %}
{% endif %}
