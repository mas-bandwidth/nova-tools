# {{ github_runner_unit }}: managed by Ansible (fleet/github-runners.yml). Edits are overwritten.
[Unit]
Description=GitHub Actions runner {{ github_runner_name }} ({{ github_runner_path }})
After=network-online.target
Wants=network-online.target

[Service]
User={{ ansible_facts['user_id'] }}
WorkingDirectory={{ github_runner_dir }}
Environment=PATH={{ github_runner_env.get('PATH', github_runner_default_path_linux) }}
Environment=TMPDIR={{ github_runner_env.get('TMPDIR', github_runner_tmpdir) }}
{% for k, v in github_runner_env.items() | sort if k not in ['PATH', 'TMPDIR'] %}
Environment={{ k }}={{ v }}
{% endfor %}
# A stop ends the whole runner: run.sh turns SIGTERM into SIGINT to run-helper.sh and the listener and waits for them
# (RUNNER_MANUALLY_TRAP_SIG), and whatever is left once run.sh exits, or at TimeoutStopSec, is killed (KillMode=mixed).
Environment=RUNNER_MANUALLY_TRAP_SIG=1
# The kernel charges io_uring's locked pages to the user across all its processes, so every runner of the login shares
# one budget that grows with the runner count; systemd's default (8 MiB) refuses that. The login has sudo already.
LimitMEMLOCK=infinity
ExecStart={{ github_runner_dir }}/run.sh
Restart=always
RestartSec=10
KillMode=mixed
# The kernel's OOM killer taking one process of a job fails that job (its step sees the kill); it must not stop the
# runner. systemd's default (OOMPolicy=stop) stopped the whole unit, so the runner left with "The runner has received a
# shutdown signal" and every job on it was cancelled (amd-1, 2026-11-12T08:48:05Z: a global OOM killed a qemu guest
# in one runner and a functional suite in the other, and both nightly jobs died as cancelled, not failed).
OOMPolicy=continue
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
