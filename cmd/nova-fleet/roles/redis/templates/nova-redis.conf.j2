# {{ nova_redis_dir }}/nova-redis.conf: managed by Ansible (fleet/redis.yml). A hand edit is overwritten.
port {{ nova_redis_port }}
bind {{ redis_bind | join(' ') }}
protected-mode yes
daemonize no
supervised systemd
dir {{ nova_redis_dir }}
aclfile {{ nova_redis_dir }}/users.acl
# The AOF fsyncs every second (a crash loses at most one second); an RDB snapshot every 60 s after any write is the
# second copy. A config change restarts the server only after a checkpoint (fleet/roles/redis/tasks/checkpoint.yml).
appendonly yes
appendfsync everysec
save 60 1
maxmemory {{ nova_redis_maxmemory }}
maxmemory-policy noeviction
notify-keyspace-events Ex
latency-monitor-threshold 100
