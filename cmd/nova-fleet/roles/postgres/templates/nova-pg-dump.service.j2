# /etc/systemd/system/nova-pg-dump.service: managed by Ansible (cmd/nova-fleet/postgres.yml).
# One pg_dump -Fc of {{ nova_pg_db }} into {{ nova_pg_dir }}/dumps/{{ nova_pg_db }}-<date>.dump, written as .partial and renamed
# in, then the dumps older than {{ nova_pg_dump_keep_days }} days removed. As postgres over the unix socket; the output goes
# to the journal (`journalctl -u nova-pg-dump`). Started by nova-pg-dump.timer. The dumps stay on this machine.
[Unit]
Description=nova-pg-dump: pg_dump -Fc {{ nova_pg_db }} into {{ nova_pg_dir }}/dumps ({{ nova_pg_dump_keep_days }} days kept)
After={{ pg_unit }}.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart=/bin/sh -ec 'f={{ nova_pg_dir }}/dumps/{{ nova_pg_db }}-$(date -u +%%Y-%%m-%%d).dump; /usr/bin/pg_dump -Fc -f "$f.partial" {{ nova_pg_db }} && mv "$f.partial" "$f" && echo "DUMP OK $f $(stat -c %%s "$f") bytes"'
ExecStartPost=/usr/bin/find {{ nova_pg_dir }}/dumps -name '{{ nova_pg_db }}-*.dump' -type f -mtime +{{ nova_pg_dump_keep_days }} -delete
