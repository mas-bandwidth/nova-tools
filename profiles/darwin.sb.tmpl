;; nova-sandbox — darwin sandbox-exec profile, TEMPLATE.
;;
;; SPEC-SANDBOX rule 15: the policy is generated, never hand-edited. This file is
;; the generator's input and the only copy of the profile text; docs/SPEC-SANDBOX.md
;; describes it and does not restate it.
;;
;; The filled text is passed to sandbox-exec INLINE with -p, never written to a file:
;; a profile file inside the write set can be replaced by a process already inside it
;; between WriteFile and Start, and is left behind on SIGKILL. -p has no file, no race
;; and no cleanup -- which is also why the darwin body need not wait to unlink anything.
;;
;; Caller paths never enter the text: they arrive as -D NAME=<resolved path> and are
;; read back as (param "NAME"). Every param named below MUST be passed with -D —
;; an unfilled param is `invalid data type of path filter; expected pattern, got
;; boolean` at exit 65, not a weaker wall.
;;
;; A line whose whole content is a marker is replaced by the generator:
;;
;;   @@OPTROOTS@@   one (allow file-read* (subpath "<root>")) per OPTIONAL root that
;;                  EXISTS on this machine (/opt/homebrew, /opt/local, and the
;;                  directory of the resolved command when it is under neither).
;;                  An absent root is skipped, never refused.
;;   @@ANCESTORS@@  one (allow file-read-metadata (literal "<dir>")) per proper
;;                  ancestor of every --read, --write, --cwd and --tmp path, "/"
;;                  excluded (it is granted file-read* above). Without these,
;;                  mkdir(2)/stat(2) on a leading component of an absolute path
;;                  inside the write set is denied and `mkdir -p`, `git init` and
;;                  `git clone` by absolute path die at /private or /Users.
;;                  file-read-metadata is stat only: LISTING an ancestor stays denied.
;;   @@READS@@      one (allow file-read* (subpath (param "READn"))) per --read, n from 0.
;;   @@WRITES@@     one (allow file-read* file-write* (subpath (param "WRITEn"))) AND one
;;                  (allow network-outbound (subpath (param "WRITEn"))) per --write, n from 0.
;;                  The second line is the ONLY unix-domain socket reach this policy
;;                  grants: a socket is a file, and a socket under the write set is the
;;                  job's own (a language server, a test harness). Everything else --
;;                  the SSH agent's socket under /private/tmp, the launchd Listeners
;;                  socket, a sibling job's socket -- is denied. Measured 2026-09-11:
;;                  with (allow network*) a connect to a socket one directory outside
;;                  the write set succeeds rc=0; with these two clauses it is rc=1
;;                  inside the wall and rc=0 outside it (profiles/darwin-check.sh,
;;                  checks unix_socket_outside and unix_socket_outside_control).
;;   @@NET@@        (allow network-outbound (remote ip) (literal "/private/var/run/mDNSResponder"))
;;                  -- IP only, never (allow network*),
;;                  which grants every unix-domain socket on the machine as well.
;;                  Under --net-listen a second line (allow network-inbound (local ip))
;;                  is emitted for a job that must listen. The marker is emitted EMPTY
;;                  under --net-deny.
;;                  The mDNSResponder literal is the DNS grant: macOS resolves names over
;;                  that unix socket, and IP-only outbound without it is a wall with no
;;                  DNS -- measured 2026-09-11, curl https://example.com is rc=6 000
;;                  without the literal and 200 with it. It is a SOCKET grant, not a
;;                  network one, and it is inside the @@NET@@ marker so that --net-deny
;;                  takes the name resolver away with the network.
;;
;; HOME is not a root and gets no grant of its own: rule 9 requires HOME to resolve
;; inside a --write, so it is already covered by that path's WRITEn grant. The
;; (param "HOME") line below is the assertion of that, passed with -D HOME=<data home>
;; and identical to one of the WRITEn paths.

(version 1)
(deny default)

;; exec and signal are TWO clauses. Folding them into
;; (allow process-exec* process-fork signal (target self)) applies the target filter
;; to the exec too and denies it: execvp() ... Operation not permitted, exit 71.
(allow process-exec* process-fork)
(allow signal (target self) (target children))

(allow sysctl-read)

;; mach-lookup is NARROWED to the three services the harnesses actually need, measured
;; 2026-09-11 on this Mac by growing the set until `/bin/sh -c true`, `git status`,
;; `curl https://example.com`, `opencode --version` and `node -e 1` all passed:
;;   opendirectoryd.libinfo  getpwuid(3)/getaddrinfo(3) -- without it HOME lookup and
;;                           name resolution fail;
;;   SecurityServer          TLS trust evaluation -- without it curl to an https name fails;
;;   system.logger           os_log(3), which libsystem calls on many paths.
;; Unqualified (allow mach-lookup) was measured to leave `pbpaste` READING THE CLIPBOARD
;; inside the wall; with this set pbpaste is rc=1 (darwin-check.sh, clipboard_denied).
;; ACCEPTED WIDTH, named rather than removed: `launchctl print system` still answers and
;; `security list-keychains` still lists the keychain FILE NAMES -- neither reads a
;; secret, and both were measured to still answer under this narrowed set. Apple Events
;; are denied at every width.
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.system.logger"))

;; The symlinks macOS puts in / are granted as literals on the LINK. (literal "/")
;; grants the root directory only; a subpath grant on /var or /tmp is not wanted.
;; Without these, `cat /etc/hosts` is denied and every /bin/sh -c dies on
;; "Error opening /private/var/select/sh".
(allow file-read* (literal "/") (literal "/etc") (literal "/tmp") (literal "/var"))

(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/dev"))
@@OPTROOTS@@

@@ANCESTORS@@

@@READS@@

@@WRITES@@
;; rule 9: HOME is inside a --write and is passed for the record.
(allow file-read* file-write* (subpath (param "HOME")))

(allow file-write* (literal "/dev/null") (literal "/dev/tty"))

;; Network is IP only. (allow network*) would also grant every unix-domain socket
;; on the machine, including an inherited SSH agent's -- #69's whole point. The
;; agent is closed twice: here, and by the wrapper stripping SSH_AUTH_SOCK and every
;; *_AGENT* variable out of the child environment before exec (rule 9).
@@NET@@
