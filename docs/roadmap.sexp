				if found || ln == \"_\" || ln == \".\" { continue }
				a, e := f2s.Position(im.Pos()).Offset, f2s.Position(im.End()).Offset; for a > 0 && b[a-1] != '\\n' { a-- }; if e < len(b) { e++ }
				b = append(b[:a], b[e:]...); gone = true; break
			}
			if !gone { break }
		}
		if f, err := format.Source(b); err == nil { b = f }
		if err := os.WriteFile(n, b, 0o644); err != nil { die(err.Error()) }
	}
	// a test that keys an exemption by \"<file>|<func>|\" follows the function to its new file
	tests, _ := filepath.Glob(filepath.Join(*dir, \"*_test.go\"))
	for _, tf := range tests {
		b, err := os.ReadFile(tf); if err != nil { die(err.Error()) }
		nb := b
		for _, u := range mv { for _, x := range u.names { nb = []byte(strings.ReplaceAll(string(nb), \"\\\"\"+filepath.Base(u.file)+\"|\"+x+\"|\", \"\\\"\"+to+\"|\"+x+\"|\")) } }
		if string(nb) != string(b) { fmt.Printf(\"MOVE keys %s\\n\", tf); if err := os.WriteFile(tf, nb, 0o644); err != nil { die(err.Error()) } }
	}
	nb := []byte(out + body)
	if f, err := format.Source(nb); err == nil { nb = f }
	if err := os.WriteFile(dest, nb, 0o644); err != nil { die(err.Error()) }
	return true
}
```
