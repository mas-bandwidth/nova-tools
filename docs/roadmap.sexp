      :brief "RESULT: split-fuse-t sha=36f4c5ba6371 tier: flash
REPO: mas-bandwidth/nova-tools
BASE: sprint/mechanical-2026-10-02
KIND: sweep
CLASS: script
DEPENDS-ON: split-wave3b,modeltests-pkg-fuse-t
PATHS: cmd/nova-fuse/*.go
NEW: cmd/nova-fuse/check.go, cmd/nova-fuse/status.go, cmd/nova-fuse/init.go
TEST: cmd/nova-fuse TestIssue1451EveryMissingFlagRefusalNamesTheDoor
Deadline: finish within 30 minutes.

You are a child of the coordinator: one task, one checkout, one branch, unattended; this card is the whole task. You start in the job directory (export JOB=$PWD): read $JOB/JOB.md first, work in the staged checkout it names (a full clone at BASE), commit as usual and finish as it says. No gh, no push: JOB.md's finish does both.
Libraries considered: Go's standard library alone (go/ast, go/parser, go/types, go/build), each program one file; nothing is added to the module.
NEW names the files this card creates; they and PATHS are this card's files, no others.

THE TASK. 1 script step (STEP 2 to STEP 2) in order; each commits its PATHS with its COMMIT: line, and its verdict line is `step <n>: <ok|broken> <the full 40-hex commit sha pasted from git rev-parse HEAD, or - when nothing changed; a short sha is refused: e.g. step 2: ok 3b1f0c2a9d4e7f6a5c8b1d0e2f3a4b5c6d7e8f90 the change> <one line>`; the first broken step stops the walk. CLASS script: no model step. Until the member runs script cards (PR 5180), you run each: write its fenced program to $JOB/step-<n>.go byte for byte, run `go run $JOB/step-<n>.go` from the checkout (no arguments), then each POST: command; edit nothing by hand. The edit is known exactly, so a program makes it and its POST: lines prove it. One file per verb (docs/STANDARD.md section 7): vmove.go moves the verb's handler and every top-level declaration of the package that only the moved code uses (a type with its methods) into `<verb>.go`, byte for byte, with the imports they need, and drops imports a source file no longer uses; a file with a //go:build line keeps its declarations; it refuses, changing nothing, when the file exists.

HOW THIS CARD IS JUDGED. (1) A [script] step's diff is exactly what its program writes from the start commit of that step: no hand edit inside it. (2) A move is a move: every removed line reappears unchanged in the new file (`git diff --color-moved=plain` shows moved blocks), give or take the new file's package clause, imports and one comment line; no identifier is renamed, no behaviour or test changes. (3) The new file holds what its name says and nothing else.

STEP 1. cd into the staged checkout JOB.md names (cd <that path>) and run git log --oneline -1: the head is 36f4c5ba6371 or a later commit of BASE. Export GOCACHE=$JOB/gocache GOFLAGS=-mod=readonly NOVA_TEST_NO_HOST=1 before any go command. Sites and counts here were read at 36f4c5ba6371: find a moved line by its text.
STEP 2. one file per verb in cmd/nova-fuse.
  PATHS: cmd/nova-fuse/*.go, cmd/nova-fuse/check.go, cmd/nova-fuse/status.go, cmd/nova-fuse/init.go
  COMMIT: split-fuse-t: one file per verb in cmd/nova-fuse
  VERDICT: ok when the program ran and every POST: holds; broken when either fails (name the line)
The program moves, one by one, each verb named in its arguments (verb and the dispatch's function at 36f4c5ba6371: check (cmdCheck), status (cmdStatus), init (cmdInit)) into its own file. A file that exists already (the head split it) is left and printed `MOVE nothing`; a root that is gone is printed `MOVE skip`, and the PR body names it.
  SCRIPT: go
```go
// vmove: go run vmove.go [-n] -dir <pkgdir> <new.go>=<root>... (pure moves of verbs into their own files; a file that exists already is left)
package main

import (\"flag\";\"fmt\";\"go/ast\";\"go/format\";\"go/parser\";\"go/token\";\"os\";\"os/exec\";\"path/filepath\";\"sort\";\"strings\")

type unit struct{ file string; a, e int; names []string; recv string; refs map[string]bool; d ast.Decl; tagged bool }
var fs = token.NewFileSet()
func off(p token.Pos) int { return fs.Position(p).Offset }
func die(s string) { fmt.Println(\"MOVE REFUSED:\", s); os.Exit(2) }
func std(p string) bool { return !strings.Contains(strings.SplitN(strings.Trim(p, `\"`), \"/\", 2)[0], \".\") }
func local(im *ast.ImportSpec) string {
	if im.Name != nil { return im.Name.Name }
	if o, err := exec.Command(\"go\", \"list\", \"-f\", \"{{.Name}}\", strings.Trim(im.Path.Value, `\"`)).Output(); err == nil { return strings.TrimSpace(string(o)) }
	p := strings.Trim(im.Path.Value, `\"`); return p[strings.LastIndex(p, \"/\")+1:]
}
var cardArgs = []string{\"-dir\", \"cmd/nova-fuse\", \"check.go=cmdCheck\", \"status.go=cmdStatus\", \"init.go=cmdInit\"}
var dry *bool
func main() {
	if len(os.Args) == 1 { os.Args = append(os.Args, cardArgs...) }
	dry = flag.Bool(\"n\", false, \"print only\"); dir := flag.String(\"dir\", \"\", \"package\"); flag.Parse(); n := 0
	for _, m := range flag.Args() {
		to, root, _ := strings.Cut(m, \"=\")
		if _, err := os.Stat(filepath.Join(*dir, to)); err == nil { fmt.Printf(\"MOVE nothing: %s exists already\\n\", filepath.Join(*dir, to)); continue }
		if move(*dir, to, root) { n++ }
	}
	fmt.Printf(\"MOVE files=%d\\n\", n)
}
func move(d, to, r string) bool {
	dir := &d; dest := filepath.Join(d, to)
	doc := fmt.Sprintf(\"%s holds the %s verb: its flags, its run and the helpers only it uses.\", to, strings.TrimSuffix(to, \".go\"))
	fs = token.NewFileSet()
	srcs, files, top, pkg := map[string][]byte{}, map[string]*ast.File{}, map[string]bool{}, \"\"
	var units []*unit
	names, _ := filepath.Glob(filepath.Join(*dir, \"*.go\"))
	for _, n := range names {
		if strings.HasSuffix(n, \"_test.go\") { continue }
		b, err := os.ReadFile(n); if err != nil { die(err.Error()) }
		f, err := parser.ParseFile(fs, n, b, parser.ParseComments); if err != nil { die(err.Error()) }
		srcs[n], files[n], pkg = b, f, f.Name.Name
		tagged := strings.Contains(string(b[:off(f.Package)]), \"//go:build\")
		for _, d := range f.Decls {
			u := &unit{file: n, d: d, refs: map[string]bool{}, tagged: tagged}; st := d.Pos()
			switch d := d.(type) {
			case *ast.FuncDecl:
				if d.Doc != nil { st = d.Doc.Pos() }
				if d.Recv == nil { u.names = []string{d.Name.Name} } else { t := d.Recv.List[0].Type; if s, ok := t.(*ast.StarExpr); ok { t = s.X }; if x, ok := t.(*ast.IndexExpr); ok { t = x.X }; if id, ok := t.(*ast.Ident); ok { u.recv = id.Name } }
			case *ast.GenDecl:
				if d.Tok == token.IMPORT { continue }
				if d.Doc != nil { st = d.Doc.Pos() }
				for _, s := range d.Specs { switch s := s.(type) { case *ast.TypeSpec: u.names = append(u.names, s.Name.Name); case *ast.ValueSpec: for _, id := range s.Names { u.names = append(u.names, id.Name) } } }
			}
			u.a, u.e = off(st), off(d.End()); for u.e < len(b) && b[u.e] != '\\n' { u.e++ }
			for _, x := range u.names { top[x] = true }
			units = append(units, u)
		}
	}
	for _, u := range units {
		ast.Inspect(u.d, func(n ast.Node) bool {
			if s, ok := n.(*ast.SelectorExpr); ok { ast.Inspect(s.X, func(m ast.Node) bool { if id, ok := m.(*ast.Ident); ok && top[id.Name] { u.refs[id.Name] = true }; return true }); return false }
			if id, ok := n.(*ast.Ident); ok && top[id.Name] { u.refs[id.Name] = true }; return true
		})
		if u.recv != \"\" { u.refs[u.recv] = true }
	}
	in := map[*unit]bool{}
	add := func(u *unit) { in[u] = true; for _, v := range units { for _, x := range u.names { if v.recv == x { in[v] = true } } } }
	{
		var u *unit
		for _, v := range units { for _, x := range v.names { if x == r { u = v } } }
		if u == nil { fmt.Printf(\"MOVE skip: no top-level %s in %s\\n\", r, *dir); return false }
		if u.tagged { fmt.Printf(\"MOVE skip: %s is in a file with a build line\\n\", r); return false }
		add(u)
	}
	for grew := true; grew; {
		grew = false
		for _, u := range units {
			if in[u] || u.recv != \"\" || u.tagged || len(u.names) == 0 || u.names[0] == \"init\" || u.names[0] == \"main\" { continue }
			users, only := 0, true
			for _, v := range units { if v != u { for _, x := range u.names { if v.refs[x] { users++; only = only && in[v] } } } }
			if users > 0 && only { add(u); grew = true }
		}
	}
	var mv []*unit
	for _, u := range units { if in[u] { mv = append(mv, u) } }
	body, used, imps := \"\", map[string]bool{}, map[string]string{}
	for _, u := range mv {
		fmt.Printf(\"MOVE %s%s %s -> %s\\n\", strings.Join(u.names, \",\"), u.recv, u.file, dest)
		body += \"\\n\" + string(srcs[u.file][u.a:u.e]) + \"\\n\"
		ast.Inspect(u.d, func(n ast.Node) bool { if s, ok := n.(*ast.SelectorExpr); ok { if id, ok := s.X.(*ast.Ident); ok && id.Obj == nil { used[id.Name] = true } }; return true })
		for _, im := range files[u.file].Imports { imps[im.Path.Value] = local(im) }
	}
	var keep []string
	for p, ln := range imps { if used[ln] { if im := p[strings.LastIndex(p, \"/\")+1:]; strings.Trim(im, `\"`) != ln { keep = append(keep, ln+\" \"+p) } else { keep = append(keep, p) } } }
	if strings.Contains(body, \"//go:embed\") && !used[\"embed\"] { keep = append(keep, \"_ \\\"embed\\\"\") }
	key := func(s string) string { f := strings.Fields(s); return f[len(f)-1] }
	sort.Slice(keep, func(i, j int) bool { a, b := key(keep[i]), key(keep[j]); if std(a) != std(b) { return std(a) }; return a < b })
	out := \"// \" + doc + \"\\n\\npackage \" + pkg + \"\\n\"
	if len(keep) > 0 {
		out += \"\\nimport (\"
		for i, k := range keep { if i > 0 && std(key(keep[i-1])) && !std(key(k)) { out += \"\\n\" }; out += \"\\n\\t\" + k }
		out += \"\\n)\\n\"
	}
	fmt.Printf(\"MOVE moved=%d to=%s\\n\", len(mv), dest)
	if *dry { return true }
	for n, b := range srcs {
		var cut []*unit
		for _, u := range mv { if u.file == n { cut = append(cut, u) } }
		if len(cut) == 0 { continue }
		for i := len(cut) - 1; i >= 0; i-- { e := cut[i].e; if e < len(b) { e++ }; if e < len(b) && b[e] == '\\n' { e++ }; b = append(b[:cut[i].a], b[e:]...) }
		for {
			f2s := token.NewFileSet(); f2, err := parser.ParseFile(f2s, n, b, parser.ParseComments); if err != nil { die(err.Error()) }
			gone := false
			for _, im := range f2.Imports {
				ln := local(im); found := false
				ast.Inspect(f2, func(x ast.Node) bool { if s, ok := x.(*ast.SelectorExpr); ok { if id, ok := s.X.(*ast.Ident); ok && id.Name == ln && id.Obj == nil { found = true } }; return !found })
				if found || ln == \"_\" || ln == \".\" { continue }
				a, e := f2s.Position(im.Pos()).Offset, f2s.Position(im.End()).Offset; for a > 0 && b[a-1] != '\\n' { a-- }; if e < len(b) { e++ }
				b = append(b[:a], b[e:]...); gone = true; break
			}
			if !gone { break }
		}
		if f, err := format.Source(b); err == nil { b = f }
		if err := os.WriteFile(n, b, 0o644); err != nil { die(err.Error()) }
	}
	// a test that keys an exemption by \"<file>|<func>|\" follows the function to its new file
	tests, _ := filepath.Glob(filepath.Join(*dir, \"*_test.go\"))
	for _, tf := range tests {
		b, err := os.ReadFile(tf); if err != nil { die(err.Error()) }
		nb := b
		for _, u := range mv { for _, x := range u.names { nb = []byte(strings.ReplaceAll(string(nb), \"\\\"\"+filepath.Base(u.file)+\"|\"+x+\"|\", \"\\\"\"+to+\"|\"+x+\"|\")) } }
		if string(nb) != string(b) { fmt.Printf(\"MOVE keys %s\\n\", tf); if err := os.WriteFile(tf, nb, 0o644); err != nil { die(err.Error()) } }
	}
	nb := []byte(out + body)
	if f, err := format.Source(nb); err == nil { nb = f }
	if err := os.WriteFile(dest, nb, 0o644); err != nil { die(err.Error()) }
	return true
}
