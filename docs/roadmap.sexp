		if u == nil { fmt.Printf(\"MOVE skip: no top-level %s in %s\\n\", r, *dir); return false }
		if u.tagged { fmt.Printf(\"MOVE skip: %s is in a file with a build line\\n\", r); return false }
		add(u)
