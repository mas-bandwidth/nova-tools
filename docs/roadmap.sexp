		srcs[n], files[n], pkg = b, f, f.Name.Name
		tagged := strings.Contains(string(b[:off(f.Package)]), \"//go:build\")
		for _, d := range f.Decls {
			u := &unit{file: n, d: d, refs: map[string]bool{}, tagged: tagged}; st := d.Pos()
			switch d := d.(type) {
			case *ast.FuncDecl:
				if d.Doc != nil { st = d.Doc.Pos() }
				if d.Recv == nil { u.names = []string{d.Name.Name} } else { t := d.Recv.List[0].Type; if s, ok := t.(*ast.StarExpr); ok { t = s.X }; if x, ok := t.(*ast.IndexExpr); ok { t = x.X }; if id, ok := t.(*ast.Ident); ok { u.recv = id.Name } }
			case *ast.GenDecl:
				if d.Tok == token.IMPORT { continue }
				if d.Doc != nil { st = d.Doc.Pos() }
				for _, s := range d.Specs { switch s := s.(type) { case *ast.TypeSpec: u.names = append(u.names, s.Name.Name); case *ast.ValueSpec: for _, id := range s.Names { u.names = append(u.names, id.Name) } } }
			}
			u.a, u.e = off(st), off(d.End()); for u.e < len(b) && b[u.e] != '\\n' { u.e++ }
			for _, x := range u.names { top[x] = true }
			units = append(units, u)
		}
	}
	for _, u := range units {
		ast.Inspect(u.d, func(n ast.Node) bool {
			if s, ok := n.(*ast.SelectorExpr); ok { ast.Inspect(s.X, func(m ast.Node) bool { if id, ok := m.(*ast.Ident); ok && top[id.Name] { u.refs[id.Name] = true }; return true }); return false }
			if id, ok := n.(*ast.Ident); ok && top[id.Name] { u.refs[id.Name] = true }; return true
		})
		if u.recv != \"\" { u.refs[u.recv] = true }
	}
