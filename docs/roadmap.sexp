Deadline: finish within 45 minutes.

You are a child of the coordinator: one task, one checkout, one branch, unattended; this card is the whole task. You start in the job directory (export JOB=$PWD): read $JOB/JOB.md first, work in the staged checkout it names (a full clone at BASE), commit as usual and finish as it says. No gh, no push: JOB.md's finish does both.
Libraries considered: Go's standard library alone (go/ast, go/parser, go/format), the program one file; testify is already the tree's assertion library and this card only moves calls onto its own assertions (ErrorIs, NotErrorIs, ErrorAs, NotErrorAs, Contains, NotContains, Len); nothing is added to the module.

THE TASK. 1 script step (STEP 2 to STEP 2) in order; each commits its PATHS with its COMMIT: line, and its verdict line is `step <n>: <ok|broken> <the full 40-hex commit sha pasted from git rev-parse HEAD, or - when nothing changed; a short sha is refused: e.g. step 2: ok 3b1f0c2a9d4e7f6a5c8b1d0e2f3a4b5c6d7e8f90 the change> <one line>`; the first broken step stops the walk. CLASS script: no model step. Until the member runs script cards (PR 5180), you run each: write its fenced program to $JOB/step-<n>.go byte for byte, run `go run $JOB/step-<n>.go cmd internal tools` from the checkout, then each POST: command; edit nothing by hand. The second testify pass (the owner: \"Once we have the basic testify usage locked in, please go ahead and use more advanced testify features to clean up and shrink tests\"): a check wrapped in True, False or Equal takes the assertion that says it (the meaning cards take comparisons; this card takes the calls they leave), so a failure prints the values instead of \"should be true\". The rewrite is known exactly, so a program makes it over the whole tree at once and the gate proves it.

HOW THIS CARD IS JUDGED. (1) A step's diff is exactly what its program writes, no hand edit. (2) Every POST: line holds. (3) A site the program leaves stays as it was. (4) Nothing outside PATHS.

STEP 1. cd into the staged checkout JOB.md names (cd <that path>) and run git log --oneline -1: the head is db6ab4ed953f or a later commit of BASE. Export GOCACHE=$JOB/gocache GOFLAGS=-mod=readonly NOVA_TEST_NO_HOST=1 before any go command. Sites and counts here were read at db6ab4ed953f: find a moved line by its text.
STEP 2. testify assertions that say the check.
  PATHS: cmd/**/*_test.go, internal/**/*_test.go, tools/**/*_test.go
  COMMIT: shrink-testify-asserts-t: testify assertions that say the check
  VERDICT: ok when the program ran and every POST: holds; broken when either fails (name the line)
At db6ab4ed953f it prints `TFX files=95 contains=47 errorAs=10 errorIs=18 len=113` (a head with more tests prints more; the POST: lines are the check). What it does, only on calls of an imported testify require or assert package (an alias counts): `True(t, errors.Is(err, X), msg...)` becomes `ErrorIs(t, err, X, msg...)` (False: NotErrorIs; errors.As: ErrorAs, NotErrorAs); `True(t, strings.Contains(s, sub), ...)` becomes `Contains(t, s, sub, ...)` (False: NotContains); `Equal(t, n, len(x), ...)` and `Equal(t, len(x), n, ...)` become `Len(t, x, n, ...)`, left alone when both sides are len calls or the length side is an index or a type assertion (it can hold an interface value, which Len does not take; an `Equal(t, true, x)` is left for the same reason, x can be any). The message arguments are kept as written. An errors or strings import the rewrite leaves unused is deleted, and the file is gofmt'd. testdata and vendor directories are skipped.
  SCRIPT: go
```go
// tfx: go run tfx.go [-n] <dir>... (a testify check wrapped in True, False or Equal takes the assertion that says it)
package main

import (
	\"bytes\"
	\"flag\"
	\"fmt\"
	\"go/ast\"
	\"go/format\"
	\"go/parser\"
	\"go/token\"
	\"io/fs\"
	\"os\"
	\"path/filepath\"
	\"sort\"
	\"strconv\"
	\"strings\"
)

type ed struct {
	a, e int
	s    string
}

var counts = map[string]int{}

func main() {
	dry := flag.Bool(\"n\", false, \"print what would change, write nothing\")
	flag.Parse()
	files := 0
	for _, root := range flag.Args() {
		err := filepath.WalkDir(root, func(p string, d fs.DirEntry, err error) error {
			if err != nil {
				return err
			}
			if d.IsDir() && (d.Name() == \"testdata\" || d.Name() == \"vendor\" || strings.HasPrefix(d.Name(), \".\")) && p != root {
				return filepath.SkipDir
			}
			if d.IsDir() || !strings.HasSuffix(p, \"_test.go\") {
				return nil
			}
			changed, err := fix(p, *dry)
			if err != nil {
				return fmt.Errorf(\"%s: %w\", p, err)
			}
			if changed {
				files++
			}
			return nil
		})
		if err != nil {
			fmt.Println(\"TFX REFUSED:\", err)
			os.Exit(2)
		}
	}
	keys := make([]string, 0, len(counts))
	for k := range counts {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	var b strings.Builder
	for _, k := range keys {
		fmt.Fprintf(&b, \" %s=%d\", k, counts[k])
	}
	fmt.Printf(\"TFX files=%d%s\\n\", files, b.String())
}

// names maps each import name of the file to its path.
func names(f *ast.File) map[string]string {
	m := map[string]string{}
	for _, im := range f.Imports {
		p, _ := strconv.Unquote(im.Path.Value)
		n := p[strings.LastIndex(p, \"/\")+1:]
		if im.Name != nil {
			n = im.Name.Name
		}
		m[n] = p
	}
	return m
}

// pkgCall reports whether e is a call of pkg.fn with n arguments, pkg an import of path.
func pkgCall(e ast.Expr, imp map[string]string, path, fn string, n int) (*ast.CallExpr, bool) {
	c, ok := e.(*ast.CallExpr)
	if !ok || len(c.Args) != n || c.Ellipsis.IsValid() {
		return nil, false
	}
	s, ok := c.Fun.(*ast.SelectorExpr)
	if !ok || s.Sel.Name != fn {
		return nil, false
	}
	x, ok := s.X.(*ast.Ident)
	return c, ok && imp[x.Name] == path
}

func isLen(e ast.Expr) (*ast.CallExpr, bool) {
	c, ok := e.(*ast.CallExpr)
	if !ok || len(c.Args) != 1 {
		return nil, false
	}
	id, ok := c.Fun.(*ast.Ident)
	return c, ok && id.Name == \"len\" && id.Obj == nil
}

func plainInt(e ast.Expr) bool { // an expression that is not a map, slice or type-assertion read, which can hold an interface value
	switch e.(type) {
	case *ast.BasicLit, *ast.Ident, *ast.SelectorExpr, *ast.BinaryExpr, *ast.CallExpr, *ast.ParenExpr:
		return true
	}
	return false
}

func fix(path string, dry bool) (bool, error) {
	src, err := os.ReadFile(path)
	if err != nil {
		return false, err
	}
	fset := token.NewFileSet()
	f, err := parser.ParseFile(fset, path, src, parser.ParseComments)
	if err != nil {
		return false, err
	}
	imp := names(f)
	testify := map[string]bool{}
	for n, p := range imp {
		if p == \"github.com/stretchr/testify/require\" || p == \"github.com/stretchr/testify/assert\" {
			testify[n] = true
		}
	}
	if len(testify) == 0 {
		return false, nil
	}
	off := func(p token.Pos) int { return fset.Position(p).Offset }
	text := func(a, b ast.Node) string { return string(src[off(a.Pos()):off(b.End())]) }
	var eds []ed
	ast.Inspect(f, func(n ast.Node) bool {
		c, ok := n.(*ast.CallExpr)
		if !ok || len(c.Args) < 2 || c.Ellipsis.IsValid() {
			return true
		}
		s, ok := c.Fun.(*ast.SelectorExpr)
		if !ok {
			return true
		}
		x, ok := s.X.(*ast.Ident)
		if !ok || !testify[x.Name] {
			return true
		}
		name, arg := s.Sel.Name, c.Args[1]
		rename := func(to, kind string, a, b ast.Node, args string) {
			eds = append(eds, ed{off(s.Sel.Pos()), off(s.Sel.End()), to}, ed{off(a.Pos()), off(b.End()), args})
			counts[kind]++
		}
		switch name {
		case \"True\", \"False\":
			neg := name == \"False\"
			if in, ok := pkgCall(arg, imp, \"errors\", \"Is\", 2); ok {
				rename(map[bool]string{false: \"ErrorIs\", true: \"NotErrorIs\"}[neg], \"errorIs\", arg, arg, text(in.Args[0], in.Args[1]))
			} else if in, ok := pkgCall(arg, imp, \"errors\", \"As\", 2); ok {
				rename(map[bool]string{false: \"ErrorAs\", true: \"NotErrorAs\"}[neg], \"errorAs\", arg, arg, text(in.Args[0], in.Args[1]))
			} else if in, ok := pkgCall(arg, imp, \"strings\", \"Contains\", 2); ok {
				rename(map[bool]string{false: \"Contains\", true: \"NotContains\"}[neg], \"contains\", arg, arg, text(in.Args[0], in.Args[1]))
			}
		case \"Equal\":
			if len(c.Args) < 3 {
				return true
			}
			a, b := c.Args[1], c.Args[2]
			if la, ok := isLen(a); ok {
				if _, also := isLen(b); !also && plainInt(b) {
					rename(\"Len\", \"len\", a, b, text(la.Args[0], la.Args[0])+\", \"+text(b, b))
				}
			} else if lb, ok := isLen(b); ok && plainInt(a) {
				rename(\"Len\", \"len\", a, b, text(lb.Args[0], lb.Args[0])+\", \"+text(a, a))
			}
		}
		return true
	})
	if len(eds) == 0 {
		return false, nil
	}
	sort.Slice(eds, func(i, j int) bool { return eds[i].a < eds[j].a })
	var out bytes.Buffer
	at := 0
	for _, e := range eds {
		if e.a < at {
			return false, fmt.Errorf(\"overlapping rewrites at offset %d\", e.a)
		}
		out.Write(src[at:e.a])
		out.WriteString(e.s)
		at = e.e
	}
	out.Write(src[at:])
	res, err := dropUnused(out.Bytes(), path)
	if err != nil {
		return false, err
	}
	if dry {
		fmt.Printf(\"TFX %s %d rewrites\\n\", path, len(eds)/2)
		return true, nil
	}
	return true, os.WriteFile(path, res, 0o644)
}

// dropUnused deletes an errors or strings import the rewrite left unused, then formats.
func dropUnused(src []byte, path string) ([]byte, error) {
	fset := token.NewFileSet()
	f, err := parser.ParseFile(fset, path, src, parser.ParseComments)
	if err != nil {
		return nil, fmt.Errorf(\"rewritten file does not parse: %w\", err)
	}
	used := map[string]bool{}
	ast.Inspect(f, func(n ast.Node) bool {
		if s, ok := n.(*ast.SelectorExpr); ok {
			if x, ok := s.X.(*ast.Ident); ok {
				used[x.Name] = true
			}
		}
		return true
	})
	var cut [][2]int
	for _, d := range f.Decls {
		g, ok := d.(*ast.GenDecl)
		if !ok || g.Tok != token.IMPORT || g.Lparen.IsValid() || len(g.Specs) != 1 {
			continue
		}
		im := g.Specs[0].(*ast.ImportSpec)
		if p, _ := strconv.Unquote(im.Path.Value); (p == \"errors\" || p == \"strings\") && im.Name == nil && !used[p] {
			cut = append(cut, [2]int{fset.Position(g.Pos()).Offset, fset.Position(g.End()).Offset})
			im.Path.Value = \"\" // handled: the single import declaration goes whole
		}
	}
	for _, im := range f.Imports {
		if im.Path.Value == \"\" {
			continue
		}
		p, _ := strconv.Unquote(im.Path.Value)
		if (p == \"errors\" || p == \"strings\") && im.Name == nil && !used[p] {
			a, b := fset.Position(im.Pos()).Offset, fset.Position(im.End()).Offset
			if s := bytes.LastIndexByte(src[:a], '\\n'); len(bytes.TrimSpace(src[s+1:a])) == 0 && b < len(src) && src[b] == '\\n' {
				a, b = s+1, b+1 // the whole line
			}
			cut = append(cut, [2]int{a, b})
		}
	}
	sort.Slice(cut, func(i, j int) bool { return cut[i][0] < cut[j][0] })
	for i := len(cut) - 1; i >= 0; i-- {
		src = append(src[:cut[i][0]:cut[i][0]], src[cut[i][1]:]...)
	}
	return format.Source(src)
}
```
