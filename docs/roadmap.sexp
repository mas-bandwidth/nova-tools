// lintfix: go run lintfix.go -fix ./<pkg>/ (staticcheck quickfix and simple suggested fixes; needs staticcheck as a module tool)
package main

import (
	\"golang.org/x/tools/go/analysis\"
	\"golang.org/x/tools/go/analysis/multichecker\"
	\"honnef.co/go/tools/quickfix\"
	\"honnef.co/go/tools/simple\"
)

func main() {
