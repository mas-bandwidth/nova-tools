	if strings.Contains(body, \"//go:embed\") && !used[\"embed\"] { keep = append(keep, \"_ \\\"embed\\\"\") }
	key := func(s string) string { f := strings.Fields(s); return f[len(f)-1] }
	sort.Slice(keep, func(i, j int) bool { a, b := key(keep[i]), key(keep[j]); if std(a) != std(b) { return std(a) }; return a < b })
	out := \"// \" + doc + \"\\n\\npackage \" + pkg + \"\\n\"
	if len(keep) > 0 {
		out += \"\\nimport (\"
		for i, k := range keep { if i > 0 && std(key(keep[i-1])) && !std(key(k)) { out += \"\\n\" }; out += \"\\n\\t\" + k }
		out += \"\\n)\\n\"
	}
	fmt.Printf(\"MOVE moved=%d to=%s\\n\", len(mv), dest)
	if *dry { return true }
	for n, b := range srcs {
		var cut []*unit
		for _, u := range mv { if u.file == n { cut = append(cut, u) } }
		if len(cut) == 0 { continue }
		for i := len(cut) - 1; i >= 0; i-- { e := cut[i].e; if e < len(b) { e++ }; if e < len(b) && b[e] == '\\n' { e++ }; b = append(b[:cut[i].a], b[e:]...) }
		for {
			f2s := token.NewFileSet(); f2, err := parser.ParseFile(f2s, n, b, parser.ParseComments); if err != nil { die(err.Error()) }
			gone := false
			for _, im := range f2.Imports {
				ln := local(im); found := false
