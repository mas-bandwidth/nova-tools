     ((:id "modeltests-pkg-bus-t" :tier "-" :needs ("modeltests-wave3b" "seams-bus-5-t")
      :title "A tree of 1 work step (STEP 2 to STEP 2), walked in order"
      :brief "RESULT: modeltests-pkg-bus-t sha=36f4c5ba6371 tier: flash
REPO: mas-bandwidth/nova-tools
BASE: sprint/mechanical-2026-10-02
KIND: sweep
CLASS: model
DEPENDS-ON: modeltests-wave3b,seams-bus-5-t
PATHS: internal/bus/*_test.go
NEW: internal/bus/model_invariants_test.go
