; docs/roadmap.sexp: the data the tables in ROADMAP.md are generated from (nova-roadmap render).
(:schema 1
 :root "goal"
 :page (:roadmaps ("future"))
 :nodes
 ((:id "goal" :type :work-set :children ("future"))
  (:id "future" :type :roadmap :title "Future work"
   :rows (
     ("reserve-slots-are-cores" "nova-reserve slots bound CPU, so N one-slot jobs cannot saturate a bench")
     ("fleet-placement" "Place one heavy job on the quietest bench fleet-wide")
     ("race-detector-tiers" "race-detector-tiers — PR #6301, branch quality/race: unit and functional tiers under -race")
     ("bus-latency-benchmarks" "bus-latency-benchmarks — PR #6302, branch perf/bus-benchmarks: functional benchmarks for nova-bus send-to-hook latency and hook idle cost")
     ("netwatch-in-up" "nova-fleet up applies the netwatch play as part of fleet setup")
     ("secrets-refresh-guards-dead-code" "Remove the dead nova_seal_store guards in roles/secrets-refresh (dead since #6279)")
     ("sandbox-self-binary-write" "nova-sandbox refuses a --write grant covering its own binary or anything on PATH that chooses it")
     ("probe-names-binary" "nova-sandbox probe prints bin= like check and show")
     ("vm-mock-fleet" "A VM mock fleet so nova-fleet up can be run cold end to end")
     ("verified-commits" "Verified commits: one GitHub account per friend and one for the fleet, each backed by a real email, so every commit shows Verified as the identity that made it")
     ("microvm-sandbox" "MicroVM sandboxing: nova-sandbox runs unattended work in a microVM with an egress allowlist, so a card branch carrying a malicious test cannot reach the host, its keys or the tailnet")
     ("runner-online-window" "Bug: the github-runner role's online check gives up after 60 s, but GitHub takes 2-4 min to release a restarted runner's session, so a good apply reports runners offline")
     ("admin-root-check" "Idea, the owner's decision: the tailnet admins' Tailscale SSH into tag:nova and tag:runner as root takes a check instead of accept; the policy merge only adds rules, so it also needs the merge to replace the old accept rule")
     ("cairn-concurrent-first-open" "nova-cairn open: two first opens of one session at the same time settle on one open record; CairnStore.tla's Open becomes a header step and a log step first, then the code follows")
     ("reserve-shared-process-group" "nova-reserve: several runs in one terminal process group (make -j, a script, a PTY harness) share the terminal and job-control stops; JobControl.tla is extended to more than one run first")
     ("sandbox-darwin-link-chains" "nova-sandbox on macOS: a --read or --write reached through a chain of symlinks or a symlinked ancestor is granted as a one-hop link is")
     ("bus-service-path" "Idea, the owner's decision: nova-bus hook --service carries the caller's PATH into the unit for --exec, as it does for --codex-thread")
     ("machine-firewall-allow-in" "nova-config machine records carry a per-machine firewall allow-in list that the tailscale role reads, so a machine's extra ufw rule (space2/space3: in on eno2 proto udp from 10.77.0.0/24) no longer depends on passing -e nova_firewall_allow_in on each up or tailscale run")
     ("retire-admin-runner" "nova-fleet windows-runners retires an admin runner whose entry left windows_admin_runners: its GitHub registration (removal token), service, directory and marked local account")
     ("bus-hook-service-record" "nova-bus hook --service writes a nova-config service record (seat, keys NOVA_BUS_PASSWORD, env) instead of a launchd or systemd unit holding the bus password in plain text; the services play then owns the unit")
     ("bus-hook-absent-wake-backoff" "nova-bus hook backs off while its wake target is absent (no Monitor on the wake file, no harness server) instead of exiting 1 and being restarted every 10 s by its supervisor (16,953 restarts in one log, 2026-11-12)")
     ("reserve-first-come" "nova-reserve hands freed slots to waiters in arrival order, so a long waiter is not passed by later ones (captain 2026-11-12: a waiter since 17:13Z was passed by three later arrivals)")
     )
   :columns (("done" "done"))
   :cells (
     ("reserve-slots-are-cores" "done" "t-reserve-slots-are-cores")
     ("fleet-placement" "done" "t-fleet-placement")
     ("race-detector-tiers" "done" "t-race-detector-tiers")
     ("bus-latency-benchmarks" "done" "t-bus-latency-benchmarks")
     ("netwatch-in-up" "done" "t-netwatch-in-up")
     ("secrets-refresh-guards-dead-code" "done" "t-secrets-refresh-guards-dead-code")
     ("sandbox-self-binary-write" "done" "t-sandbox-self-binary-write")
     ("probe-names-binary" "done" "t-probe-names-binary")
     ("vm-mock-fleet" "done" "t-vm-mock-fleet")
     ("verified-commits" "done" "t-verified-commits")
     ("microvm-sandbox" "done" "t-microvm-sandbox")
     ("runner-online-window" "done" "t-runner-online-window")
     ("admin-root-check" "done" "t-admin-root-check")
     ("cairn-concurrent-first-open" "done" "t-cairn-concurrent-first-open")
     ("reserve-shared-process-group" "done" "t-reserve-shared-process-group")
     ("sandbox-darwin-link-chains" "done" "t-sandbox-darwin-link-chains")
     ("bus-service-path" "done" "t-bus-service-path")
     ("machine-firewall-allow-in" "done" "t-machine-firewall-allow-in")
     ("retire-admin-runner" "done" "t-retire-admin-runner")
     ("bus-hook-service-record" "done" "t-bus-hook-service-record")
     ("bus-hook-absent-wake-backoff" "done" "t-bus-hook-absent-wake-backoff")
     ("reserve-first-come" "done" "t-reserve-first-come")
     ))
