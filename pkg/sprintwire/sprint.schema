// sprint.schema: the sprint worker answer records, as the worker's reader
// meets them on the wire. Every form the reader accepts reads the same table:
// the binary wire, the padded standard base64 of it, the schema JSON text, and
// the legacy JSON the server writes today. The tables are VARIABLE: the answer
// is a message a server and a worker exchange, and an older reader may meet a
// newer writer's answer, so a variable table skips and counts a field it does
// not know instead of refusing the message.
//
// The table names are spelled ResultWire and ResponseWire so the generated Go
// does not clash with the package's existing Result and Response types; the
// reader maps a read table back to those.
package sprintwire

table ResultWire
{
    // code: the verb's exit code, as nova-sprint would exit (0 done, 1 the
    // verb ran and said no, 2 usage or a store that did not answer).
    code    int32 | min = 0, max = 65535
    // stdout: what the verb printed to stdout; stderr: to stderr.
    stdout  string(1048576)
    stderr  string(1048576)
    // outcome: what the verb's run says became of its write, beside its exit
    // code: accepted, refused or unknown; empty when the server names none.
    outcome string(32)
    // changed: whether the verb wrote: yes, no or unknown; empty when the
    // server names none.
    changed string(32)
}

// ResponseWire: a server's answers, one per verb, in the request's order.
table ResponseWire
{
    results []ResultWire
}
