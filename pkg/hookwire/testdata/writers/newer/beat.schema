// beat.schema: the friend beat's hot scalars, what a friend's daemon tells the
// sprint server on each beat (today the argv of `friend beat`): who beats, its
// clock, when its session was last active, a down beat's until and reason, and
// the stop-returns its lanes still owe. The unbounded per-friend live_seen map
// stays in the stored record and is not on this wire. Its Go is generated
// into pkg/hookwire (go generate ./pkg/hookwire).
//
// A VARIABLE table: friends exchange it, so an older reader may meet a newer
// writer's beat and skips and counts a field it does not know.
//
// Absent reads as zero in a variable table, so every field a liveness count
// reads is either text a reader refuses when empty (friend_name) or an
// optional (?T) whose presence the reader checks: no stop-returns owed is a
// real answer (0), an absent count is a malformed beat. The runtime clamps an
// over-bound value and counts it; the reader refuses every clamp.
package hookwire

table Beat
{
    // friend_name: the beating friend, as nova-bus names a sender (64 bytes).
    // Spelled friend_name because friend is a reserved word in C++ and the
    // compiler refuses it in every language's unit.
    friend_name  string(64)
    // sent_ms: the friend's clock when it wrote the beat, Unix milliseconds.
    sent_ms      ?int64
    // active_ms: when the friend's session was last active, Unix
    // milliseconds; absent when the daemon knows no activity yet.
    active_ms    ?int64
    // until_ms and reason: a down beat, the friend away until until_ms for
    // reason; both absent on an up beat, both present on a down beat.
    until_ms     ?int64
    reason       string(200)
    // stop_returns: the stop-returns the friend's lanes still owe the server
    // (a machine stop cancelled their cards); at most one per lane, and a
    // friend's lane width is at most 1024.
    stop_returns ?uint32 | min = 0, max = 1024
    lanes        ?uint32
}
