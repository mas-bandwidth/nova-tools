// A WIDER writer of the envelope, for the reader's fixtures only: every bound
// the reader holds is wider here, one kind and one field are new. Its wires are
// made by the generated Go of this definition (testdata/writers/write).
package wide

// Kind is the kind of a message, pkg/bus Kinds. Append only: a variant's
// ordinal is its wire value. The implicit None (0) is a message that names no
// kind, which pkg/bus reads as status.
enum Kind { status, report, ack, request, blocker, ask, timeout, judgment, notice }

// Name is one recipient: lowercase letters, digits and hyphens, at most
// pkg/bus MaxName (64) bytes. An element table, so a list of names is an array
// of tables and a name can grow fields without a new wire kind.
table Name
{
    s string(128)
}

table Envelope
{
    // id: the bus's message id, a ULID (26 bytes) made at send.
    id      string(64)
    // from: the sender's name (MaxName).
    from    string(64)
    // to and cc: the recipients. pkg/bus holds no count bound; the roster
    // has more than 16 names today, so the bound is 64, room for a send to
    // every name.
    to      [..128]Name
    cc      [..128]Name
    // re: the id of the message this one answers, empty when none.
    re      string(64)
    kind    Kind
    // subject: one line, at most 200 bytes.
    subject string(400)
    // card and head: the card a message is about and the commit it names,
    // typed so a judgment is no longer read out of the subject; empty when the
    // message is about no card. head is 40 lowercase hex, checked by the reader.
    card    string(64)
    head    string(40)
    // token: the sender's retry token, the same on every retry of one send
    // (pkg/bus MaxToken = 128); empty for a send with none.
    token   string(128)
    // at_ms: when the store stamped the message, milliseconds since the Unix
    // epoch. Optional, so a message with no stamp is absent, never read as
    // the epoch.
    at_ms   ?int64
    // due_ms: an ask's deadline, the store's at plus the ask's wait, in
    // milliseconds since the Unix epoch; absent on a message that is no ask.
    due_ms  ?int64
    // body: the message's prose, unchecked by the schema, capped by the
    // reader at pkg/bus MaxBody (1 MiB); absent is no body.
    body    *string
    // priority: a field the reader does not know.
    priority uint8
}
